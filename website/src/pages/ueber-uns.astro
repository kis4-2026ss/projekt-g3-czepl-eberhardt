---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {
  getAbout, getPageHeader, getTeam,
  getUeberUnsCopy, getHomeCopy, md,
} from '../lib/directus';
const [about, team, header, copy, home] = await Promise.all([
  getAbout(),
  getTeam(),
  getPageHeader('ueber-uns'),
  getUeberUnsCopy(),
  getHomeCopy(),
]);
const storyHtml = md(about.story);
---

<Layout title={header?.title} description={header?.seo_description || about.subtitle}>
  <PageHeader header={header} fallbackTitle={about.title} fallbackLead={about.subtitle} />

  <!-- Story -->
  <section class="section bg-w-cream">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-16">
      <!-- Text -->
      <div class="lg:col-span-2 fade-up">
        <p class="eyebrow mb-4">{copy.story_eyebrow}</p>
        <h2 class="font-serif text-3xl sm:text-4xl text-w-dark font-medium tracking-tight mb-8">{about.title}</h2>
        <div class="prose prose-stone max-w-none text-w-dark/80 leading-[1.85] font-light text-[17px] sm:text-lg" set:html={storyHtml} />
      </div>

      <!-- Sidebar stats + philosophy -->
      <aside class="space-y-6 sm:space-y-8 fade-up delay-200">
        <div class="grid grid-cols-2 gap-4 sm:gap-6">
          <div class="card p-7 sm:p-8 text-center">
            <p class="font-serif text-4xl sm:text-5xl font-medium text-w-gold leading-none">{about.founded_year}</p>
            <p class="text-w-stone text-[11px] mt-3 tracking-[0.25em] uppercase">{home.founded_label}</p>
          </div>
          <div class="card p-7 sm:p-8 text-center">
            <p class="font-serif text-4xl sm:text-5xl font-medium text-w-gold leading-none">{about.generations}.</p>
            <p class="text-w-stone text-[11px] mt-3 tracking-[0.25em] uppercase">{home.generation_label}</p>
          </div>
        </div>
        <blockquote class="bg-w-dark rounded-md p-8 sm:p-10 text-white relative overflow-hidden">
          <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
               style="background-image:radial-gradient(circle,#c69c6d 1px,transparent 1px);background-size:16px 16px"></div>
          <div class="absolute -right-4 -top-4 opacity-[0.07] text-w-gold pointer-events-none">
            <svg class="w-32 h-32" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
          </div>
          <p class="eyebrow mb-4 relative z-10">{copy.philosophy_eyebrow}</p>
          <p class="text-white/95 leading-[1.8] text-lg sm:text-xl italic font-serif relative z-10">"{about.philosophy}"</p>
        </blockquote>
      </aside>
    </div>
  </section>

  <!-- Team -->
  <section class="section bg-w-linen/30">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div class="flex justify-center mb-14 sm:mb-16">
        <SectionHeader eyebrow={copy.team_eyebrow} title={copy.team_title} />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {team.map((member, index) => (
          <article data-preview-collection="team" data-preview-id={member.id} class={`card card-hover p-8 sm:p-10 text-center fade-up delay-${(index % 3 + 1) * 100}`}>
            <div class="w-20 h-20 mx-auto rounded-full bg-w-dark flex items-center justify-center mb-6 ring-4 ring-w-gold/15">
              <span class="font-serif text-2xl font-medium text-w-gold">
                {member.first_name.charAt(0)}{member.last_name.charAt(0)}
              </span>
            </div>
            <h3 class="font-serif font-medium text-w-dark text-xl sm:text-2xl">
              {member.first_name} {member.last_name}
            </h3>
            <p class="text-w-gold text-[10px] font-semibold tracking-[0.22em] uppercase mt-2 mb-5">{member.role}</p>
            {member.bio && <p class="text-w-stone/95 text-[15px] leading-relaxed font-light">{member.bio}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
