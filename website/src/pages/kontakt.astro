---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import {
  getPageHeader, getSiteSettings, getOpeningHours,
  getKontaktCopy, getUiCopy,
} from '../lib/directus';
const [settings, hours, header, copy, ui] = await Promise.all([
  getSiteSettings(),
  getOpeningHours(),
  getPageHeader('kontakt'),
  getKontaktCopy(),
  getUiCopy(),
]);

function tmpl(s: string, vars: Record<string, string>) {
  return s.replace(/\{(\w+)\}/g, (_m, k) => vars[k] ?? '');
}

const seoDescription = header?.seo_description || tmpl(copy.seo_description_template, {
  site_name: settings.site_name,
  address_street: settings.address_street,
  address_city: settings.address_city,
});
---

<Layout title={header?.title} description={seoDescription}>
  <PageHeader header={header} />

  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-20 sm:py-24 grid grid-cols-1 lg:grid-cols-5 gap-8 sm:gap-10">

    <!-- Contact info + reservation CTA -->
    <div class="lg:col-span-2 space-y-6 sm:space-y-8 fade-up">
      <div class="card p-8 sm:p-10 space-y-6">
        <!-- Address -->
        <div class="flex gap-4">
          <div class="w-11 h-11 rounded-full bg-w-linen flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-w-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p data-cms-collection="ui_copy" data-cms-field="address_label" class="text-[11px] font-semibold text-w-stone uppercase tracking-[0.22em] mb-1.5">{ui.address_label}</p>
            <address class="not-italic text-w-dark text-[15px] leading-relaxed">
              <span data-cms-collection="site_settings" data-cms-field="address_street">{settings.address_street}</span><br />
              <span data-cms-collection="site_settings" data-cms-field="address_zip">{settings.address_zip}</span> <span data-cms-collection="site_settings" data-cms-field="address_city">{settings.address_city}</span>
            </address>
            {settings.google_maps_url && (
              <a href={settings.google_maps_url} target="_blank" rel="noopener"
                 data-cms-collection="ui_copy" data-cms-field="maps_short_label"
                 class="inline-flex items-center gap-1 text-w-gold text-xs font-semibold tracking-[0.18em] uppercase mt-3 hover:text-w-gold-light transition-colors">
                {ui.maps_short_label}
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            )}
          </div>
        </div>

        <div class="border-t border-w-linen"></div>

        <!-- Phone -->
        <div class="flex gap-4">
          <div class="w-11 h-11 rounded-full bg-w-linen flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-w-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p data-cms-collection="ui_copy" data-cms-field="phone_label" class="text-[11px] font-semibold text-w-stone uppercase tracking-[0.22em] mb-1.5">{ui.phone_label}</p>
            <a href={`tel:${settings.contact_phone.replace(/\s/g,'')}`}
               data-cms-collection="site_settings" data-cms-field="contact_phone"
               class="text-w-dark text-[15px] font-medium hover:text-w-green transition-colors">
              {settings.contact_phone}
            </a>
            <p data-cms-collection="ui_copy" data-cms-field="phone_hours_note" class="text-w-stone text-xs mt-1.5 font-light">{ui.phone_hours_note}</p>
          </div>
        </div>

        <div class="border-t border-w-linen"></div>

        <!-- Email -->
        <div class="flex gap-4">
          <div class="w-11 h-11 rounded-full bg-w-linen flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-w-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p data-cms-collection="ui_copy" data-cms-field="email_label" class="text-[11px] font-semibold text-w-stone uppercase tracking-[0.22em] mb-1.5">{ui.email_label}</p>
            <a href={`mailto:${settings.contact_email}`}
               data-cms-collection="site_settings" data-cms-field="contact_email"
               class="text-w-dark text-[15px] font-medium hover:text-w-green transition-colors break-all">
              {settings.contact_email}
            </a>
          </div>
        </div>
      </div>

      <!-- Reservation CTA -->
      <div class="bg-w-dark rounded-md p-8 sm:p-10 text-white relative overflow-hidden fade-up delay-100">
        <div class="absolute inset-0 opacity-[0.04] pointer-events-none"
             style="background-image:radial-gradient(circle,#c69c6d 1px,transparent 1px);background-size:18px 18px"></div>
        <div class="absolute -right-6 -bottom-6 opacity-[0.08] text-w-gold pointer-events-none">
          <svg class="w-32 h-32" fill="currentColor" viewBox="0 0 24 24"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        </div>
        <div class="relative z-10">
          <p data-cms-collection="kontakt_copy" data-cms-field="reservation_eyebrow" class="eyebrow mb-3">{copy.reservation_eyebrow}</p>
          <h3 data-cms-collection="kontakt_copy" data-cms-field="reservation_title" class="font-serif text-2xl sm:text-3xl font-medium mb-3">{copy.reservation_title}</h3>
          <p data-cms-collection="kontakt_copy" data-cms-field="reservation_text" class="text-white/70 text-[15px] leading-relaxed mb-6 font-light max-w-sm">
            {copy.reservation_text}
          </p>
          <a href={`tel:${settings.contact_phone.replace(/\s/g,'')}`}
             data-cms-collection="kontakt_copy" data-cms-field="reservation_cta_label"
             class="btn btn-primary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            {copy.reservation_cta_label}
          </a>
        </div>
      </div>
    </div>

    <!-- Opening hours -->
    <div class="lg:col-span-3 fade-up delay-200">
      <div class="card overflow-hidden">
        <div class="px-8 sm:px-10 py-7 border-b border-w-linen flex items-baseline justify-between gap-4 bg-w-cream/50">
          <h2 data-cms-collection="kontakt_copy" data-cms-field="hours_title" class="font-serif text-2xl sm:text-3xl font-medium text-w-dark">{copy.hours_title}</h2>
          <p data-cms-collection="kontakt_copy" data-cms-field="hours_subtitle" class="text-w-stone text-[11px] font-semibold uppercase tracking-[0.22em] hidden sm:block">{copy.hours_subtitle}</p>
        </div>
        <table class="w-full">
          <tbody>
            {hours.map(h => (
              <tr data-cms-collection="opening_hours" data-cms-id={String(h.id)} class:list={['border-b border-w-linen/70 last:border-0', h.closed ? 'opacity-55' : '']}>
                <td data-cms-field="weekday" class="px-6 sm:px-8 py-5 font-serif text-w-dark text-base sm:text-lg w-32 sm:w-40 align-middle">{h.weekday}</td>
                {h.closed
                  ? <td data-cms-collection="ui_copy" data-cms-field="closed_label" class="px-6 sm:px-8 py-5 text-w-stone text-sm italic font-light" colspan="2">{ui.closed_label}</td>
                  : <>
                      <td class="px-6 sm:px-8 py-5 text-sm align-middle">
                        <span class="font-medium text-w-dark tabular-nums">
                          <span data-cms-field="open_from">{h.open_from}</span> – <span data-cms-field="open_to">{h.open_to}</span>
                        </span>
                        <span class="block text-w-stone text-xs mt-1 font-light">
                          <span data-cms-collection="ui_copy" data-cms-field="kitchen_label">{ui.kitchen_label}</span>:
                          <span class="tabular-nums"><span data-cms-field="kitchen_from">{h.kitchen_from}</span> – <span data-cms-field="kitchen_to">{h.kitchen_to}</span></span>
                        </span>
                      </td>
                      <td class="px-6 sm:px-8 py-5 text-right align-middle">
                        {h.note && (
                          <span data-cms-field="note" class="inline-block px-2.5 py-1 rounded-full bg-w-gold/12 text-w-gold text-[11px] font-semibold tracking-wide">
                            {h.note}
                          </span>
                        )}
                      </td>
                    </>
                }
              </tr>
            ))}
          </tbody>
        </table>
        <div class="px-6 sm:px-8 py-4 bg-w-linen/40 border-t border-w-linen/60">
          <p data-cms-collection="kontakt_copy" data-cms-field="hours_footer_note" class="text-w-stone text-xs font-light leading-relaxed">{copy.hours_footer_note}</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
