---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getFaqItems, getFaqCopy, getPageHeader } from '../lib/directus';
import { applyPreviewList } from '../lib/preview';

let [faqItems, copy, header] = await Promise.all([getFaqItems(), getFaqCopy(), getPageHeader('faq')]);
const { preview } = Astro.locals;
faqItems = applyPreviewList(faqItems, preview, 'faq');
---

<Layout title={header?.title} description={header?.seo_description}>
  <PageHeader header={header} />

  <!-- FAQ accordion -->
  <section class="max-w-3xl mx-auto px-5 sm:px-6 lg:px-8 py-20 sm:py-24">
    <div class="space-y-3">
      {faqItems.map((item, index) => (
        <details class={`group card overflow-hidden fade-up delay-${(index % 5) * 100}`}>
          <summary class="flex items-center justify-between gap-4 px-6 sm:px-8 py-5 sm:py-6 cursor-pointer list-none select-none hover:bg-w-cream/70 transition-colors">
            <span class="font-serif text-lg sm:text-xl font-medium text-w-dark group-hover:text-w-gold transition-colors">{item.question}</span>
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-w-cream flex items-center justify-center text-w-gold group-open:rotate-45 transition-transform duration-300">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14"/></svg>
            </span>
          </summary>
          <div class="px-6 sm:px-8 pb-7 pt-1">
            <p class="text-w-dark/75 leading-[1.8] text-[15px] sm:text-base border-t border-w-linen/70 pt-5 font-light">{item.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <div class="mt-16 text-center card p-10 sm:p-12 fade-up">
      <p class="eyebrow mb-3">{copy.help_eyebrow}</p>
      <p class="font-serif text-2xl sm:text-3xl text-w-dark font-medium mb-3">{copy.help_title}</p>
      <p class="text-w-stone text-base mb-8 font-light max-w-md mx-auto">{copy.help_text}</p>
      <a href={copy.help_cta_href} class="btn btn-primary">
        {copy.help_cta_label}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>
</Layout>
