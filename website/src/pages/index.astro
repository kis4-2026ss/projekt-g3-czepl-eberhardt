---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {
  getSiteSettings, getHero, getAbout,
  getFeaturedDishes, getTestimonials, getEvents, getOpeningHours,
  getHomeCopy, getUiCopy, assetUrl,
} from '../lib/directus';
const [settings, hero, about, featured, testimonials, events, hours, home, ui] = await Promise.all([
  getSiteSettings(), getHero(), getAbout(),
  getFeaturedDishes(), getTestimonials(), getEvents(), getOpeningHours(),
  getHomeCopy(), getUiCopy(),
]);

function stars(n: number) { return '★'.repeat(n) + '☆'.repeat(5 - n); }
function formatDate(d: string | null) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('de-AT', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout title={settings.site_name} description={hero.subheadline}>

  <!-- ── Hero ────────────────────────────────────────────────── -->
  <section data-cms-collection="hero" class="relative min-h-[92vh] flex items-center justify-center overflow-hidden">
    <img src={assetUrl(hero.image)} alt={hero.image_alt}
         data-cms-collection="hero" data-cms-field="image"
         class="absolute inset-0 w-full h-full object-cover object-center" />
    <!-- two-stop gradient for crisp readability without crushing the image -->
    <div class="absolute inset-0 bg-gradient-to-b from-w-dark/55 via-w-dark/35 to-w-dark/85"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_30%,rgba(11,22,14,0.45)_100%)]"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-28 w-full mt-16 text-center">
      <div class="max-w-4xl mx-auto fade-up flex flex-col items-center">
        {hero.eyebrow && (
          <p data-cms-collection="hero" data-cms-field="eyebrow"
             class="inline-flex items-center gap-4 text-w-gold text-xs sm:text-sm font-semibold tracking-[0.32em] uppercase mb-7">
            <span class="w-10 sm:w-14 h-px bg-w-gold/80"></span>
            {hero.eyebrow}
            <span class="w-10 sm:w-14 h-px bg-w-gold/80"></span>
          </p>
        )}
        <h1 data-cms-collection="hero" data-cms-field="headline"
            class="font-serif text-[2.75rem] sm:text-6xl lg:text-[5.5rem] xl:text-[6.5rem] text-white font-medium leading-[1.04] mb-7 tracking-tight drop-shadow-2xl">
          {hero.headline}
        </h1>
        {hero.subheadline && (
          <p data-cms-collection="hero" data-cms-field="subheadline"
             class="text-white/90 text-lg sm:text-xl font-light leading-relaxed mb-10 max-w-2xl mx-auto fade-up delay-100 drop-shadow-lg">
            {hero.subheadline}
          </p>
        )}
        <div class="flex flex-col sm:flex-row justify-center gap-4 w-full sm:w-auto fade-up delay-200">
          {hero.cta_primary_label && (
            <a href={hero.cta_primary_link}
               data-cms-collection="hero" data-cms-field="cta_primary_label"
               class="btn btn-primary">
              {hero.cta_primary_label}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          )}
          {hero.cta_secondary_label && (
            <a href={hero.cta_secondary_link}
               data-cms-collection="hero" data-cms-field="cta_secondary_label"
               class="btn btn-ghost">
              {hero.cta_secondary_label}
            </a>
          )}
        </div>
      </div>
    </div>

    <a href="#featured" aria-label="Weiter scrollen" class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/60 hover:text-w-gold transition-colors fade-up delay-300">
      <span class="block animate-bounce">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/></svg>
      </span>
    </a>
  </section>

  <!-- ── Featured dishes ─────────────────────────────────────── -->
  <section id="featured" class="section bg-w-cream">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div class="flex justify-center mb-14 sm:mb-16">
        <SectionHeader eyebrow={home.featured_eyebrow} title={home.featured_title}
                       cmsCollection="home_copy" cmsEyebrowField="featured_eyebrow" cmsTitleField="featured_title" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {featured.map((item, index) => (
          <article data-cms-collection="menu_items" data-cms-id={String(item.id)}
                   class={`card card-hover p-8 sm:p-10 group fade-up delay-${(index % 3 + 1) * 100}`}>
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="min-w-0">
                <p data-cms-collection="categories"
                   data-cms-id={item.category?.id != null ? String(item.category.id) : undefined}
                   data-cms-field="name"
                   class="text-w-stone text-[11px] font-semibold uppercase tracking-[0.22em] mb-3">{item.category?.name}</p>
                <h3 data-cms-field="name"
                    class="font-serif text-2xl font-medium text-w-dark leading-snug group-hover:text-w-gold transition-colors duration-300">{item.name}</h3>
              </div>
              <span data-cms-field="price"
                    class="text-w-gold font-medium text-lg whitespace-nowrap mt-1">€{Number(item.price).toFixed(2)}</span>
            </div>
            {item.description && <p data-cms-field="description" class="text-w-dark/70 text-[15px] leading-relaxed font-light">{item.description}</p>}
            {(item.is_vegetarian || item.is_vegan) && (
              <div class="flex gap-2 mt-6 flex-wrap">
                {item.is_vegan && <span data-cms-collection="ui_copy" data-cms-field="vegan_label" class="px-2.5 py-1 bg-w-green/5 text-w-green text-[10px] font-semibold uppercase tracking-[0.18em] rounded-sm">{ui.vegan_label}</span>}
                {item.is_vegetarian && !item.is_vegan && <span data-cms-collection="ui_copy" data-cms-field="vegetarian_label" class="px-2.5 py-1 bg-w-green/5 text-w-green text-[10px] font-semibold uppercase tracking-[0.18em] rounded-sm">{ui.vegetarian_label}</span>}
              </div>
            )}
          </article>
        ))}
      </div>
      <div class="text-center mt-14 fade-up delay-300">
        <a href="/speisekarte" data-cms-collection="home_copy" data-cms-field="featured_all_link_label" class="inline-link">
          {home.featured_all_link_label}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── About teaser ────────────────────────────────────────── -->
  <section data-cms-collection="about" class="section bg-w-dark text-w-cream relative overflow-hidden">
    <img src={assetUrl(about.image)} alt={about.title}
         data-cms-collection="about" data-cms-field="image"
         class="absolute inset-0 w-full h-full object-cover opacity-15 mix-blend-luminosity" />
    <div class="absolute inset-0 bg-gradient-to-r from-w-dark/95 via-w-dark/85 to-w-dark/55"></div>
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center relative z-10">
      <div class="fade-up">
        <p data-cms-collection="home_copy" data-cms-field="about_eyebrow" class="eyebrow mb-5">{home.about_eyebrow}</p>
        <h2 data-cms-collection="about" data-cms-field="title"
            class="font-serif text-4xl sm:text-5xl lg:text-[3.25rem] text-white font-medium leading-[1.1] tracking-tight mb-6">
          {about.title}
        </h2>
        <p data-cms-collection="about" data-cms-field="subtitle"
           class="text-w-gold/95 text-xl sm:text-2xl leading-relaxed mb-8 italic font-serif">{about.subtitle}</p>
        <p data-cms-collection="about" data-cms-field="story"
           class="text-white/75 leading-[1.85] font-light text-base sm:text-lg max-w-xl">
          {(about.story.split('\n\n')[0] ?? '').replace(/\*\*/g, '')}
        </p>
        <a href="/ueber-uns" data-cms-collection="home_copy" data-cms-field="about_link_label" class="inline-link on-dark mt-10">
          {home.about_link_label}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
      <div class="space-y-6 fade-up delay-200">
        <div class="grid grid-cols-2 gap-4 sm:gap-6">
          <div class="bg-white/5 backdrop-blur-md rounded-md p-8 sm:p-10 text-center border border-white/10 hover:bg-white/10 transition-colors duration-500">
            <p data-cms-collection="about" data-cms-field="founded_year"
               class="font-serif text-5xl sm:text-6xl font-medium text-w-gold leading-none">{about.founded_year}</p>
            <p data-cms-collection="home_copy" data-cms-field="founded_label"
               class="text-white/55 text-[11px] mt-4 tracking-[0.25em] uppercase">{home.founded_label}</p>
          </div>
          <div class="bg-white/5 backdrop-blur-md rounded-md p-8 sm:p-10 text-center border border-white/10 hover:bg-white/10 transition-colors duration-500">
            <p data-cms-collection="about" data-cms-field="generations"
               class="font-serif text-5xl sm:text-6xl font-medium text-w-gold leading-none">{about.generations}.</p>
            <p data-cms-collection="home_copy" data-cms-field="generation_label"
               class="text-white/55 text-[11px] mt-4 tracking-[0.25em] uppercase">{home.generation_label}</p>
          </div>
        </div>
        <blockquote class="bg-w-green rounded-md p-8 sm:p-10 border border-white/5 relative overflow-hidden">
          <div class="absolute -right-4 -top-4 opacity-[0.07] text-w-gold pointer-events-none">
            <svg class="w-44 h-44" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
          </div>
          <p data-cms-collection="about" data-cms-field="philosophy"
             class="text-white/95 leading-[1.75] italic text-lg sm:text-xl font-serif relative z-10">"{about.philosophy}"</p>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ── Testimonials ────────────────────────────────────────── -->
  <section class="section bg-w-cream">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div class="flex justify-center mb-14 sm:mb-16">
        <SectionHeader eyebrow={home.testimonials_eyebrow} title={home.testimonials_title}
                       cmsCollection="home_copy" cmsEyebrowField="testimonials_eyebrow" cmsTitleField="testimonials_title" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {testimonials.slice(0, 3).map((t, index) => (
          <blockquote data-cms-collection="testimonials" data-cms-id={String(t.id)}
                      class={`card p-8 sm:p-10 flex flex-col fade-up delay-${(index % 3 + 1) * 100}`}>
            <p data-cms-field="rating" class="text-w-gold text-xl tracking-[0.2em] mb-6">{stars(t.rating)}</p>
            <p data-cms-field="quote" class="text-w-dark/80 leading-[1.8] italic flex-1 text-lg font-serif">"{t.quote}"</p>
            <footer class="mt-8 pt-6 border-t border-w-linen flex items-center justify-between">
              <p data-cms-field="author" class="font-medium text-w-dark text-base">{t.author}</p>
              <p data-cms-field="location" class="text-w-stone text-[11px] uppercase tracking-[0.22em]">{t.location}</p>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Events preview ──────────────────────────────────────── -->
  <section class="section bg-w-linen/40">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 sm:gap-10 mb-14 sm:mb-16 fade-up">
        <SectionHeader eyebrow={home.events_eyebrow} title={home.events_title} align="left" ornament={false}
                       cmsCollection="home_copy" cmsEyebrowField="events_eyebrow" cmsTitleField="events_title" />
        <a href="/events" data-cms-collection="home_copy" data-cms-field="events_all_link_label" class="inline-link whitespace-nowrap">
          {home.events_all_link_label}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        {events.slice(0, 4).map((ev, index) => (
          <article data-cms-collection="events" data-cms-id={String(ev.id)}
                   class={`card card-hover p-7 sm:p-8 fade-up delay-${(index % 2 + 1) * 100}`}>
            <div class="flex items-start gap-6">
              <div class="flex-shrink-0 w-16 h-16 rounded-md bg-w-green flex items-center justify-center">
                <svg class="w-7 h-7 text-w-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <div class="flex-1 min-w-0 pt-1">
                <h3 data-cms-field="title" class="font-serif font-medium text-w-dark text-xl sm:text-2xl leading-snug">{ev.title}</h3>
                {ev.subtitle && <p data-cms-field="subtitle" class="text-w-stone text-[15px] mt-1.5 font-light">{ev.subtitle}</p>}
                {ev.starts_on && (
                  <p data-cms-field={ev.is_recurring ? 'recurrence_note' : 'starts_on'}
                     class="text-w-gold text-[11px] font-semibold uppercase tracking-[0.22em] mt-4">
                    {ev.is_recurring ? ev.recurrence_note : formatDate(ev.starts_on)}
                    {ev.ends_on && !ev.is_recurring && ` – ${formatDate(ev.ends_on)}`}
                  </p>
                )}
                {ev.description && (
                  <p data-cms-field="description" class="text-w-dark/70 text-[15px] mt-3 leading-relaxed line-clamp-2 font-light">{ev.description}</p>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Opening hours strip ─────────────────────────────────── -->
  <section class="section bg-w-green text-white relative">
    <div class="absolute inset-0 opacity-[0.04]"
         style="background-image:radial-gradient(circle,#c69c6d 1px,transparent 1px);background-size:24px 24px"></div>
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 relative z-10">
      <div class="flex justify-center mb-12 sm:mb-14 fade-up">
        <div class="text-center max-w-3xl">
          <p data-cms-collection="home_copy" data-cms-field="opening_hours_eyebrow"
             class="eyebrow mb-5 inline-flex items-center gap-3 justify-center">
            <span class="w-8 h-px bg-w-gold/70 hidden sm:inline-block"></span>
            <span>{home.opening_hours_eyebrow}</span>
            <span class="w-8 h-px bg-w-gold/70 hidden sm:inline-block"></span>
          </p>
          <h2 data-cms-collection="home_copy" data-cms-field="opening_hours_title"
              class="font-serif text-3xl sm:text-4xl lg:text-[2.75rem] text-white font-medium tracking-tight">
            {home.opening_hours_title}
          </h2>
        </div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3 sm:gap-4 fade-up delay-100">
        {hours.map(h => (
          <div data-cms-collection="opening_hours" data-cms-id={String(h.id)}
               class:list={[
            'rounded-md p-5 sm:p-6 text-center transition-all duration-300',
            h.closed ? 'bg-white/5 opacity-60' : 'bg-white/[0.07] border border-white/10 hover:bg-white/15 hover:-translate-y-0.5',
          ]}>
            <p data-cms-field="weekday" class="text-w-gold text-[10px] sm:text-[11px] font-semibold uppercase tracking-[0.28em] mb-3">{h.weekday.slice(0,3)}</p>
            {h.closed
              ? <p data-cms-collection="ui_copy" data-cms-field="closed_label" class="text-white/60 text-sm font-light italic">{ui.closed_label}</p>
              : <>
                  <p class="text-white text-[15px] sm:text-base font-medium tracking-wide tabular-nums">
                    <span data-cms-field="open_from">{h.open_from}</span>–<span data-cms-field="open_to">{h.open_to}</span>
                  </p>
                  {h.note && <p data-cms-field="note" class="text-white/55 text-[11px] mt-2 font-light leading-relaxed">{h.note}</p>}
                </>
            }
          </div>
        ))}
      </div>
      <p class="text-center mt-12 sm:mt-14 fade-up delay-200">
        <a href="/kontakt" data-cms-collection="home_copy" data-cms-field="opening_hours_link_label" class="inline-link on-dark">
          {home.opening_hours_link_label}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </p>
    </div>
  </section>
</Layout>
