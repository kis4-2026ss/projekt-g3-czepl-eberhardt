---
import Layout from '../layouts/Layout.astro';
import { getMenuItems, getCategories } from '../lib/directus';

const [items, categories] = await Promise.all([getMenuItems(), getCategories()]);

const byCategory = categories.map(cat => ({
  ...cat,
  items: items.filter(i => i.category?.id === cat.id && i.available !== false),
})).filter(c => c.items.length > 0);

function slug(name: string) { return name.toLowerCase().replace(/[^a-z0-9]+/g, '-'); }
---

<Layout title="Speisekarte">
  <!-- Page header -->
  <div class="bg-w-green py-16 px-5 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <p class="text-w-gold text-xs font-semibold tracking-[0.2em] uppercase mb-3">Was wir anbieten</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-white font-semibold">Speisekarte</h1>
      <p class="text-white/60 mt-3 max-w-xl">Saisonal, regional, hausgemacht. Wenn etwas aus ist, ist es aus.</p>
    </div>
  </div>

  <!-- Sticky category nav -->
  <nav class="sticky top-16 sm:top-20 z-40 bg-white/95 backdrop-blur-sm border-b border-w-linen shadow-sm">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <ul class="flex gap-1 overflow-x-auto py-3 scrollbar-hide">
        {byCategory.map(cat => (
          <li>
            <a
              href={`#${slug(cat.name)}`}
              class="whitespace-nowrap px-4 py-2 rounded-lg text-sm font-medium text-w-stone hover:text-w-green hover:bg-w-linen transition-colors block"
            >
              {cat.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- Menu sections -->
  <div class="max-w-7xl mx-auto px-5 lg:px-8 py-12 space-y-16">
    {byCategory.map(cat => (
      <section id={slug(cat.name)} class="scroll-mt-36">
        <div class="mb-8">
          <h2 class="font-serif text-2xl sm:text-3xl text-w-dark font-semibold">{cat.name}</h2>
          {cat.description && <p class="text-w-stone text-sm mt-1 italic">{cat.description}</p>}
        </div>

        <div class="divide-y divide-w-linen">
          {cat.items.map(item => (
            <article class="py-5 flex items-start gap-4 group">
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-4">
                  <h3 class="font-medium text-w-dark group-hover:text-w-green transition-colors">{item.name}</h3>
                  <span class="flex-shrink-0 font-semibold text-w-gold">€{Number(item.price).toFixed(2)}</span>
                </div>
                {item.description && <p class="text-w-stone text-sm mt-1 leading-relaxed">{item.description}</p>}
                <div class="flex flex-wrap gap-1.5 mt-2">
                  {item.is_vegan       && <span class="text-xs px-2 py-0.5 rounded-full bg-green-50 text-green-700 border border-green-200">vegan</span>}
                  {item.is_vegetarian && !item.is_vegan && <span class="text-xs px-2 py-0.5 rounded-full bg-green-50 text-green-700 border border-green-200">vegetarisch</span>}
                  {item.allergens?.map(a => (
                    <span class="text-xs px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">{a}</span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <!-- Allergen note -->
  <div class="max-w-7xl mx-auto px-5 lg:px-8 pb-16">
    <p class="text-w-stone text-xs leading-relaxed border-t border-w-linen pt-6 max-w-2xl">
      Allergene und Unverträglichkeiten: Unsere Mitarbeiter informieren Sie gerne über alle verwendeten Zutaten.
      Irrtümer und saisonale Änderungen vorbehalten.
    </p>
  </div>
</Layout>
