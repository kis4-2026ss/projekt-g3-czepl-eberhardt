---
import { assetUrl } from '../lib/directus';
import type { PageHeader as PageHeaderType } from '../lib/directus';

interface Props {
  header?: PageHeaderType | undefined;
  fallbackTitle?: string;
  fallbackEyebrow?: string;
  fallbackLead?: string;
}
const { header, fallbackTitle = '', fallbackEyebrow = '', fallbackLead = '' } = Astro.props;

const title    = header?.title   || fallbackTitle;
const eyebrow  = header?.eyebrow || fallbackEyebrow;
const lead     = header?.lead    || fallbackLead;
const imageUrl = assetUrl(header?.image);
---

<header class="relative bg-w-green text-white overflow-hidden">
  {imageUrl && (
    <img
      src={imageUrl}
      alt={title}
      class="absolute inset-0 w-full h-full object-cover opacity-30"
      loading="eager"
    />
  )}
  <!-- no gradients: keep a clean header image treatment -->
  <div class="absolute inset-0 opacity-[0.04]"
       style="background-image:radial-gradient(circle,#c69c6d 1px,transparent 1px);background-size:22px 22px"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 pt-36 sm:pt-44 pb-20 sm:pb-24">
    <div class="max-w-3xl fade-up">
      {eyebrow && (
        <p class="inline-flex items-center gap-3 text-w-gold text-xs font-semibold tracking-[0.28em] uppercase mb-6">
          <span class="w-8 h-px bg-w-gold/70"></span>
          <span>{eyebrow}</span>
        </p>
      )}
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl xl:text-7xl text-white font-medium tracking-tight leading-[1.05]">
        {title}
      </h1>
      {lead && (
        <p class="text-white/80 mt-6 sm:mt-8 max-w-2xl text-base sm:text-lg font-light leading-relaxed fade-up delay-100">
          {lead}
        </p>
      )}
    </div>
  </div>
  <!-- bottom transition removed (was a gradient) -->
</header>
