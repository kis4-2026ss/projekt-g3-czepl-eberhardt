---
import type { PreviewEntry } from '../lib/preview';

interface Props {
  preview: PreviewEntry;
  token: string;
}

const { preview, token } = Astro.props;

const actionLabel: Record<string, string> = {
  create: 'Neuer Eintrag',
  update: 'Änderung',
  update_singleton: 'Aktualisierung',
  delete: 'Löschung',
};

const label = `${actionLabel[preview.action] ?? preview.action}: ${preview.collection}${preview.id != null ? ` #${preview.id}` : ''}`;
const hasDiff = preview.diff && preview.diff.length > 0;
---

<div class="fixed bottom-0 left-0 right-0 z-50 shadow-2xl">

  <!-- Collapsible diff panel -->
  {hasDiff && (
    <div id="preview-panel" class="hidden bg-amber-50 border-t-2 border-amber-200">
      <div class="max-w-7xl mx-auto px-5 py-4">
        <p class="text-xs text-amber-700 font-semibold uppercase tracking-wider mb-3">Geänderte Felder</p>
        <table class="text-sm border-collapse">
          <thead>
            <tr>
              <th class="text-left py-1.5 px-3 text-amber-800 font-semibold bg-amber-100 border border-amber-200 w-36">Feld</th>
              <th class="text-left py-1.5 px-3 text-red-700 font-semibold bg-red-50 border border-amber-200 min-w-[140px]">Vorher</th>
              <th class="text-left py-1.5 px-3 text-green-700 font-semibold bg-green-50 border border-amber-200 min-w-[140px]">Nachher</th>
            </tr>
          </thead>
          <tbody>
            {preview.diff!.map(d => (
              <tr>
                <td class="py-1.5 px-3 font-mono text-amber-900 bg-white border border-amber-200 whitespace-nowrap">{d.field}</td>
                <td class="py-1.5 px-3 font-mono text-red-600 bg-red-50/50 border border-amber-200 line-through">{JSON.stringify(d.before)}</td>
                <td class="py-1.5 px-3 font-mono text-green-700 bg-green-50/50 border border-amber-200 font-semibold">{JSON.stringify(d.after)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <!-- Main bar -->
  <div class="bg-amber-400 border-t-2 border-amber-500">
    <div class="max-w-7xl mx-auto px-5 py-2.5 flex items-center gap-3 flex-wrap">

      <span class="inline-flex items-center gap-2 text-amber-900 font-semibold text-sm">
        <span class="w-2 h-2 rounded-full bg-amber-800 animate-pulse flex-shrink-0"></span>
        Vorschau — {label}
      </span>

      {hasDiff && (
        <button id="preview-toggle" type="button"
          class="inline-flex items-center gap-1.5 text-amber-900 text-xs font-medium border border-amber-600/50 rounded-full px-3 py-1 hover:bg-amber-500 transition-colors">
          <svg id="toggle-chevron" class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
          <span id="toggle-label">Änderungen</span>
        </button>
      )}

      <div class="flex gap-2 ml-auto">
        <form method="POST" action="/api/confirm" data-astro-reload>
          <input type="hidden" name="token" value={token} />
          <button type="submit"
            class="px-4 py-1.5 bg-green-700 text-white text-sm font-semibold rounded hover:bg-green-800 transition-colors shadow-sm">
            ✓ Übernehmen
          </button>
        </form>
        <form method="POST" action="/api/discard" data-astro-reload>
          <input type="hidden" name="token" value={token} />
          <button type="submit"
            class="px-4 py-1.5 bg-red-600 text-white text-sm font-semibold rounded hover:bg-red-700 transition-colors shadow-sm">
            ✗ Verwerfen
          </button>
        </form>
      </div>

    </div>
  </div>
</div>

<script define:vars={{ previewCollection: preview.collection, previewId: preview.action === 'create' ? '__preview_new__' : (preview.id != null ? String(preview.id) : null), previewIsNew: preview.action === 'create' }}>
  // Toggle diff panel
  const toggle = document.getElementById('preview-toggle');
  const panel = document.getElementById('preview-panel');
  const chevron = document.getElementById('toggle-chevron');
  const toggleLabel = document.getElementById('toggle-label');
  let open = false;

  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      open = !open;
      panel.classList.toggle('hidden', !open);
      if (chevron) chevron.style.transform = open ? 'rotate(180deg)' : '';
      if (toggleLabel) toggleLabel.textContent = open ? 'Schließen' : 'Änderungen';
    });
  }

  // Highlight the changed element on the page
  function highlightChangedElement() {
    document.querySelectorAll('.preview-highlight, .preview-highlight-new').forEach(el => {
      el.classList.remove('preview-highlight', 'preview-highlight-new');
    });
    if (!previewId) return;
    const el = document.querySelector(
      `[data-preview-collection="${previewCollection}"][data-preview-id="${previewId}"]`
    );
    if (!el) return;
    el.classList.add(previewIsNew ? 'preview-highlight-new' : 'preview-highlight');
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  highlightChangedElement();
  document.addEventListener('astro:page-load', highlightChangedElement);
</script>

<style is:global>
  .preview-highlight {
    outline: 2px solid #f59e0b !important;
    outline-offset: 4px;
    box-shadow: 0 0 0 6px rgba(245, 158, 11, 0.15) !important;
    border-radius: 4px;
  }

  .preview-highlight-new {
    outline: 2px solid #16a34a !important;
    outline-offset: 4px;
    box-shadow: 0 0 0 6px rgba(22, 163, 74, 0.15) !important;
    border-radius: 4px;
  }

  [data-preview-id="__preview_new__"]::before {
    content: 'Neu';
    display: inline-block;
    background: #16a34a;
    color: white;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 3px;
    margin-bottom: 6px;
  }

  /* Space for fixed banner */
  body { padding-bottom: 56px; }
</style>
