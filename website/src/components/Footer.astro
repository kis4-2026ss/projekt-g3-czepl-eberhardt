---
import type { SiteSettings } from '../lib/directus';

interface Props { settings: SiteSettings }
const { settings } = Astro.props;

const year = new Date().getFullYear();
const navLinks = [
  { href: '/speisekarte', label: 'Speisekarte' },
  { href: '/ueber-uns',  label: 'Über uns'    },
  { href: '/events',     label: 'Events'      },
  { href: '/faq',        label: 'FAQ'         },
  { href: '/kontakt',    label: 'Kontakt'     },
];
---

<footer class="bg-w-green-dark text-white/70">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Brand -->
      <div>
        <p class="font-serif text-white text-xl font-semibold mb-1">{settings.site_name}</p>
        <p class="text-w-gold/70 text-xs tracking-widest uppercase mb-4">{settings.tagline}</p>
        <p class="text-sm leading-relaxed text-white/50 max-w-xs">{settings.footer_note}</p>
        <div class="flex gap-4 mt-5">
          {settings.instagram_url && (
            <a href={settings.instagram_url} target="_blank" rel="noopener" aria-label="Instagram"
               class="text-white/40 hover:text-w-gold transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          )}
          {settings.facebook_url && (
            <a href={settings.facebook_url} target="_blank" rel="noopener" aria-label="Facebook"
               class="text-white/40 hover:text-w-gold transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Nav -->
      <div>
        <p class="text-white text-sm font-semibold tracking-wider uppercase mb-4">Navigation</p>
        <ul class="space-y-2">
          {navLinks.map(l => (
            <li>
              <a href={l.href} class="text-sm hover:text-white transition-colors">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <p class="text-white text-sm font-semibold tracking-wider uppercase mb-4">Kontakt</p>
        <address class="not-italic space-y-2 text-sm">
          <p>{settings.address_street}<br />{settings.address_zip} {settings.address_city}</p>
          <p>
            <a href={`tel:${settings.contact_phone.replace(/\s/g, '')}`}
               class="hover:text-white transition-colors">{settings.contact_phone}</a>
          </p>
          <p>
            <a href={`mailto:${settings.contact_email}`}
               class="hover:text-white transition-colors">{settings.contact_email}</a>
          </p>
          {settings.google_maps_url && (
            <p>
              <a href={settings.google_maps_url} target="_blank" rel="noopener"
                 class="inline-flex items-center gap-1 text-w-gold/80 hover:text-w-gold transition-colors text-xs mt-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                Auf Google Maps öffnen
              </a>
            </p>
          )}
        </address>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-white/30">
      <p>© {year} {settings.site_name}. Alle Rechte vorbehalten.</p>
      <p>Ein Familienbetrieb seit {new Date().getFullYear() - 1897 + 1897} — oder einfach: seit Generationen.</p>
    </div>
  </div>
</footer>
