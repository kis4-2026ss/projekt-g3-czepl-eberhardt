---
import type { SiteSettings } from '../lib/directus';

interface Props { settings: SiteSettings }
const { settings } = Astro.props;

const links = [
  { href: '/speisekarte', label: 'Speisekarte' },
  { href: '/ueber-uns',  label: 'Über uns'    },
  { href: '/events',     label: 'Events'      },
  { href: '/faq',        label: 'FAQ'         },
];
const path = Astro.url.pathname;
---

<header class="fixed top-0 inset-x-0 z-50 transition-all duration-300" id="main-nav">
  <!-- Solid background that fades in on scroll -->
  <div class="absolute inset-0 bg-w-green/95 backdrop-blur-md border-b border-white/5 opacity-0 transition-opacity duration-300" id="nav-bg"></div>

  <div class="max-w-7xl mx-auto px-5 lg:px-8 relative z-10">
    <div class="flex items-center justify-between h-20 sm:h-24 transition-all duration-300" id="nav-container">

      <!-- Logo -->
      <a href="/" class="group flex flex-col leading-tight">
        <span class="font-serif text-white text-xl sm:text-2xl font-medium tracking-wide group-hover:text-w-gold transition-colors duration-300">
          {settings.site_name}
        </span>
        <span class="text-w-gold/80 text-[10px] tracking-[0.25em] uppercase mt-0.5">{settings.tagline}</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-8">
        {links.map(l => (
          <a
            href={l.href}
            class:list={[
              'text-sm font-medium transition-colors duration-300 uppercase tracking-wider',
              path.startsWith(l.href) ? 'text-w-gold' : 'text-white/80 hover:text-white',
            ]}
          >
            {l.label}
          </a>
        ))}
        <a
          href="/kontakt"
          class="ml-2 px-6 py-2.5 rounded-sm bg-w-gold text-white text-sm font-medium tracking-wide uppercase hover:bg-white hover:text-w-dark transition-colors duration-300"
        >
          Reservieren
        </a>
      </nav>

      <!-- Mobile toggle -->
      <button id="nav-toggle" class="md:hidden text-white p-2 -mr-2" aria-label="Menü">
        <svg id="icon-open"   class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="icon-close"  class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="nav-drawer" class="hidden md:hidden absolute top-full inset-x-0 border-t border-white/10 bg-w-green/95 backdrop-blur-xl">
    <nav class="flex flex-col px-5 py-6 gap-2">
      {links.map(l => (
        <a href={l.href} class="text-white/90 hover:text-w-gold py-3 text-lg font-serif border-b border-white/5 transition-colors">
          {l.label}
        </a>
      ))}
      <a href="/kontakt" class="mt-6 px-5 py-4 rounded-sm bg-w-gold text-white text-sm font-medium tracking-wide uppercase text-center hover:bg-white hover:text-w-dark transition-colors">
        Tisch reservieren
      </a>
    </nav>
  </div>
</header>

<script>
  function setupNav() {
    const toggle = document.getElementById('nav-toggle');
    const drawer = document.getElementById('nav-drawer');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    const bg = document.getElementById('nav-bg');
    const container = document.getElementById('nav-container');

    if (!toggle || !drawer || !iconOpen || !iconClose || !bg || !container) return;

    // Remove existing event listeners by replacing the toggle element
    const newToggle = toggle.cloneNode(true);
    toggle.parentNode?.replaceChild(newToggle, toggle);

    newToggle.addEventListener('click', () => {
      const isHidden = drawer.classList.contains('hidden');
      if (isHidden) {
        drawer.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
        bg.classList.remove('opacity-0');
        bg.classList.add('opacity-100');
      } else {
        drawer.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        if (window.scrollY < 50) {
          bg.classList.add('opacity-0');
          bg.classList.remove('opacity-100');
        }
      }
    });

    const onScroll = () => {
      if (window.scrollY > 50) {
        bg.classList.remove('opacity-0');
        bg.classList.add('opacity-100');
        container.classList.remove('h-20', 'sm:h-24');
        container.classList.add('h-16', 'sm:h-20');
      } else {
        if (drawer.classList.contains('hidden')) {
          bg.classList.add('opacity-0');
          bg.classList.remove('opacity-100');
        }
        container.classList.remove('h-16', 'sm:h-20');
        container.classList.add('h-20', 'sm:h-24');
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // Run on initial load
  setupNav();
  // Run on view transitions
  document.addEventListener('astro:after-swap', setupNav);
</script>
