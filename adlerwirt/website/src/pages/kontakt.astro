---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import {
  getPageHeader, getSiteSettings, getOpeningHours,
  getKontaktCopy, getUiCopy,
} from '../lib/directus';
const [settings, hours, header, copy, ui] = await Promise.all([
  getSiteSettings(),
  getOpeningHours(),
  getPageHeader('kontakt'),
  getKontaktCopy(),
  getUiCopy(),
]);

function tmpl(s: string, vars: Record<string, string>) {
  return s.replace(/\{(\w+)\}/g, (_m, k) => vars[k] ?? '');
}

const seoDescription = header?.seo_description || tmpl(copy.seo_description_template, {
  site_name: settings.site_name,
  address_street: settings.address_street,
  address_city: settings.address_city,
});
---

<Layout title={header?.title} description={seoDescription}>
  <PageHeader header={header} />

  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-20 sm:py-24 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">

    <!-- ── Contact details ─────────────────────────────────────── -->
    <div class="lg:col-span-5 space-y-6 sm:space-y-8 fade-up">

      <!-- Address / phone / email — editorial blocks rather than a card -->
      <div class="space-y-7">
        <div class="grid grid-cols-[2.5rem_1fr] gap-5 items-baseline">
          <span class="font-serif italic text-w-gold-dark text-2xl leading-none">I.</span>
          <div>
            <p data-cms-collection="ui_copy" data-cms-field="address_label" class="eyebrow mb-2">{ui.address_label}</p>
            <address class="not-italic text-w-dark text-lg sm:text-xl font-serif leading-snug">
              <span data-cms-collection="site_settings" data-cms-field="address_street">{settings.address_street}</span><br />
              <span data-cms-collection="site_settings" data-cms-field="address_zip">{settings.address_zip}</span> <span data-cms-collection="site_settings" data-cms-field="address_city">{settings.address_city}</span>
            </address>
            {settings.google_maps_url && (
              <a href={settings.google_maps_url} target="_blank" rel="noopener"
                 data-cms-collection="ui_copy" data-cms-field="maps_short_label"
                 class="inline-flex items-center gap-1.5 text-w-gold-dark text-[11px] font-semibold tracking-[0.32em] uppercase mt-4 hover:text-w-dark transition-colors border-b border-w-gold/40 pb-1">
                {ui.maps_short_label}
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            )}
          </div>
        </div>

        <div class="h-px w-full bg-w-linen"></div>

        <div class="grid grid-cols-[2.5rem_1fr] gap-5 items-baseline">
          <span class="font-serif italic text-w-gold-dark text-2xl leading-none">II.</span>
          <div>
            <p data-cms-collection="ui_copy" data-cms-field="phone_label" class="eyebrow mb-2">{ui.phone_label}</p>
            <a href={`tel:${settings.contact_phone.replace(/\s/g,'')}`}
               data-cms-collection="site_settings" data-cms-field="contact_phone"
               class="font-serif text-2xl sm:text-3xl text-w-dark tabular-nums hover:text-w-gold-dark transition-colors">
              {settings.contact_phone}
            </a>
            <p data-cms-collection="ui_copy" data-cms-field="phone_hours_note" class="text-w-stone text-[13px] mt-2 font-light italic">{ui.phone_hours_note}</p>
          </div>
        </div>

        <div class="h-px w-full bg-w-linen"></div>

        <div class="grid grid-cols-[2.5rem_1fr] gap-5 items-baseline">
          <span class="font-serif italic text-w-gold-dark text-2xl leading-none">III.</span>
          <div>
            <p data-cms-collection="ui_copy" data-cms-field="email_label" class="eyebrow mb-2">{ui.email_label}</p>
            <a href={`mailto:${settings.contact_email}`}
               data-cms-collection="site_settings" data-cms-field="contact_email"
               class="font-serif text-lg sm:text-xl text-w-dark hover:text-w-gold-dark transition-colors break-all">
              {settings.contact_email}
            </a>
          </div>
        </div>
      </div>

      <!-- Reservation CTA -->
      <div class="bg-w-dark p-8 sm:p-10 text-white relative overflow-hidden fade-up delay-100 mt-10">
        <div class="absolute -right-6 -bottom-6 opacity-[0.07] text-w-gold pointer-events-none">
          <svg class="w-40 h-40"><use href="#m-eagle" /></svg>
        </div>
        <div class="relative z-10">
          <p data-cms-collection="kontakt_copy" data-cms-field="reservation_eyebrow" class="eyebrow on-dark mb-4">{copy.reservation_eyebrow}</p>
          <h3 data-cms-collection="kontakt_copy" data-cms-field="reservation_title" class="font-serif text-2xl sm:text-3xl font-medium text-white mb-4 tracking-tight leading-tight">{copy.reservation_title}</h3>
          <p data-cms-collection="kontakt_copy" data-cms-field="reservation_text" class="text-white/70 text-[15px] leading-[1.8] mb-7 font-light max-w-sm">
            {copy.reservation_text}
          </p>
          <a href={`tel:${settings.contact_phone.replace(/\s/g,'')}`}
             data-cms-collection="kontakt_copy" data-cms-field="reservation_cta_label"
             class="btn btn-gold">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            {copy.reservation_cta_label}
          </a>
        </div>
      </div>
    </div>

    <!-- ── Opening hours — refined table ──────────────────────── -->
    <div class="lg:col-span-7 fade-up delay-200">
      <div class="bg-w-paper border border-w-linen p-8 sm:p-10 lg:p-12 relative overflow-hidden">
        <div class="absolute top-6 right-6 text-w-gold/15">
          <svg class="w-24 h-24"><use href="#m-eagle" /></svg>
        </div>
        <div class="relative z-10">
          <div class="flex items-baseline gap-4 mb-3 text-w-gold-dark">
            <span class="font-serif italic text-3xl leading-none">IV.</span>
            <span class="h-px w-12 bg-w-gold/40 self-center"></span>
          </div>
          <h2 data-cms-collection="kontakt_copy" data-cms-field="hours_title" class="h-display text-w-dark text-3xl sm:text-4xl lg:text-[2.75rem] mb-2">{copy.hours_title}</h2>
          <p data-cms-collection="kontakt_copy" data-cms-field="hours_subtitle" class="text-w-stone text-[11px] uppercase tracking-[0.32em] font-semibold mb-8">{copy.hours_subtitle}</p>

          <ul class="divide-y divide-w-linen">
            {hours.map(h => (
              <li data-cms-collection="opening_hours" data-cms-id={String(h.id)}
                  class:list={[
                    'grid grid-cols-[7rem_1fr_auto] sm:grid-cols-[9rem_1fr_auto] items-baseline gap-6 py-5',
                    h.closed ? 'opacity-50' : '',
                  ]}>
                <p data-cms-field="weekday" class="font-serif text-w-dark text-lg sm:text-xl tracking-tight">{h.weekday}</p>
                {h.closed ? (
                  <p data-cms-collection="ui_copy" data-cms-field="closed_label" class="text-w-stone italic font-serif text-base">{ui.closed_label}</p>
                ) : (
                  <div class="text-w-dark">
                    <p class="font-serif tabular-nums text-lg sm:text-xl">
                      <span data-cms-field="open_from">{h.open_from}</span>
                      <span class="text-w-stone mx-2">—</span>
                      <span data-cms-field="open_to">{h.open_to}</span>
                    </p>
                    <p class="text-w-stone text-[11px] mt-1 tracking-wide">
                      <span data-cms-collection="ui_copy" data-cms-field="kitchen_label">{ui.kitchen_label}</span>:
                      <span class="tabular-nums"><span data-cms-field="kitchen_from">{h.kitchen_from}</span>–<span data-cms-field="kitchen_to">{h.kitchen_to}</span></span>
                    </p>
                  </div>
                )}
                {!h.closed && h.note ? (
                  <span data-cms-field="note" class="text-[10px] uppercase tracking-[0.32em] text-w-gold-dark font-semibold whitespace-nowrap">{h.note}</span>
                ) : <span></span>}
              </li>
            ))}
          </ul>

          <p data-cms-collection="kontakt_copy" data-cms-field="hours_footer_note" class="text-w-stone text-[12px] mt-8 pt-6 border-t border-w-linen font-light italic">{copy.hours_footer_note}</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
