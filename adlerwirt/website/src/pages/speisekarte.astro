---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getMenuItems, getCategories, getPageHeader, getSpeisekarteCopy, getUiCopy } from '../lib/directus';
const [items, categories, header, copy, ui] = await Promise.all([
  getMenuItems(),
  getCategories(),
  getPageHeader('speisekarte'),
  getSpeisekarteCopy(),
  getUiCopy(),
]);

const byCategory = categories.map(cat => ({
  ...cat,
  items: items.filter(i => {
    const catId = typeof i.category === 'object' ? (i.category as any)?.id : i.category;
    return catId === cat.id && i.available !== false;
  }),
})).filter(c => c.items.length > 0);

function slug(name: string) { return name.toLowerCase().replace(/[^a-z0-9]+/g, '-'); }

const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
---

<Layout title={header?.title} description={header?.seo_description}>
  <PageHeader header={header} />

  <!-- Sticky category nav — pill rail -->
  <nav id="cat-nav" class="sticky top-16 sm:top-20 z-40 bg-w-cream/90 backdrop-blur-md border-b border-w-linen/70 transition-shadow">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <ul class="flex gap-1 sm:gap-2 overflow-x-auto py-4 scrollbar-hide">
        {byCategory.map((cat, i) => (
          <li>
            <a
              href={`#${slug(cat.name)}`}
              data-cat-link={slug(cat.name)}
              class="cat-link flex items-baseline gap-2 whitespace-nowrap px-5 py-2.5 rounded-full text-[12px] font-semibold tracking-[0.16em] uppercase text-w-stone border border-transparent hover:border-w-gold/40 hover:text-w-dark hover:bg-white/80 transition-all"
            >
              <span class="font-serif italic text-[15px] tracking-normal opacity-70">{ROMAN[i]}.</span>
              <span>{cat.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- Menu sections -->
  <div class="max-w-5xl mx-auto px-5 sm:px-6 lg:px-8 py-20 sm:py-24 space-y-24 sm:space-y-28">
    {byCategory.map((cat, idx) => (
      <section id={slug(cat.name)} data-cms-collection="categories" data-cms-id={String(cat.id)} class="scroll-mt-40 fade-up">
        <header class="mb-12 sm:mb-14">
          <div class="flex items-baseline gap-4 mb-4 text-w-gold-dark">
            <span class="font-serif italic text-4xl sm:text-5xl leading-none font-medium">{ROMAN[idx]}.</span>
            <span class="h-px flex-1 bg-w-gold/30"></span>
            <span class="text-[11px] uppercase tracking-[0.36em] text-w-stone font-semibold">Kapitel {idx + 1}</span>
          </div>
          <h2 data-cms-field="name" class="h-display text-w-dark text-4xl sm:text-5xl lg:text-[3.4rem]">{cat.name}</h2>
          {cat.description && (
            <p data-cms-field="description" class="text-w-stone text-base sm:text-lg mt-5 italic max-w-2xl font-serif leading-relaxed">{cat.description}</p>
          )}
        </header>

        <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-14 gap-y-7">
          {cat.items.map(item => (
            <li data-cms-collection="menu_items" data-cms-id={String(item.id)} class="group">
              <article class="py-4 border-b border-w-linen/80 hover:border-w-gold/40 transition-colors">
                <div class="flex items-baseline gap-3">
                  <h3 data-cms-field="name" class="font-serif font-medium text-w-dark text-lg sm:text-[1.25rem] leading-snug group-hover:text-w-gold-dark transition-colors">{item.name}</h3>
                  <span class="leader"></span>
                  <span data-cms-field="price" class="font-serif font-medium text-w-gold-dark text-base sm:text-lg whitespace-nowrap tabular-nums">€{Number(item.price).toFixed(2)}</span>
                </div>
                {item.description && <p data-cms-field="description" class="text-w-stone/95 text-[14px] sm:text-[15px] mt-1.5 leading-relaxed font-light pr-4">{item.description}</p>}
                {(item.is_vegan || item.is_vegetarian || (item.allergens && item.allergens.length > 0)) && (
                  <div class="flex flex-wrap gap-x-3 gap-y-1.5 mt-2.5 items-baseline">
                    {item.is_vegan       && <span data-cms-collection="ui_copy" data-cms-field="vegan_label" class="text-[10px] uppercase tracking-[0.24em] text-w-green font-semibold">{ui.vegan_label}</span>}
                    {item.is_vegetarian && !item.is_vegan && <span data-cms-collection="ui_copy" data-cms-field="vegetarian_label" class="text-[10px] uppercase tracking-[0.24em] text-w-green font-semibold">{ui.vegetarian_label}</span>}
                    {item.allergens && item.allergens.length > 0 && (
                      <span data-cms-field="allergens" class="text-[10px] uppercase tracking-[0.18em] text-w-stone/75 font-medium">
                        Allergene · {item.allergens.join(' · ')}
                      </span>
                    )}
                  </div>
                )}
              </article>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <!-- Allergen note + closing flourish -->
  <div class="max-w-5xl mx-auto px-5 sm:px-6 lg:px-8 pb-24">
    <div class="border-t border-w-linen pt-10 flex flex-col lg:flex-row lg:items-start gap-8">
      <div class="text-w-gold-dark flex-shrink-0">
        <svg class="w-12 h-16"><use href="#m-wheat" /></svg>
      </div>
      <p class="text-w-stone text-[13px] leading-relaxed max-w-3xl font-light">
        <strong data-cms-collection="speisekarte_copy" data-cms-field="allergen_title" class="font-semibold text-w-dark/80 block text-[11px] uppercase tracking-[0.32em] mb-2">{copy.allergen_title}</strong>
        <span data-cms-collection="speisekarte_copy" data-cms-field="allergen_note">{copy.allergen_note}</span>
        <span data-cms-collection="speisekarte_copy" data-cms-field="allergen_disclaimer">{copy.allergen_disclaimer}</span>
      </p>
    </div>
  </div>

  <script>
    function setupCatNav() {
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.cat-link'));
      const sections = links
        .map(a => {
          const id = a.getAttribute('data-cat-link');
          return id ? document.getElementById(id) : null;
        })
        .filter((el): el is HTMLElement => !!el);

      if (!sections.length) return;

      const setActive = (id: string) => {
        links.forEach(a => {
          if (a.getAttribute('data-cat-link') === id) {
            a.classList.add('!bg-w-green', '!text-white', 'border-transparent');
            a.classList.remove('text-w-stone');
          } else {
            a.classList.remove('!bg-w-green', '!text-white');
            a.classList.add('text-w-stone');
          }
        });
      };

      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter(e => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible[0]) setActive(visible[0].target.id);
      }, { rootMargin: '-40% 0px -55% 0px', threshold: [0, 0.1, 0.5] });

      sections.forEach(s => observer.observe(s));
    }
    setupCatNav();
    document.addEventListener('astro:after-swap', setupCatNav);
  </script>
</Layout>
