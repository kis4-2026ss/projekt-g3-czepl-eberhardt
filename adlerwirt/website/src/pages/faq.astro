---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getFaqItems, getFaqCopy, getPageHeader } from '../lib/directus';
const [faqItems, copy, header] = await Promise.all([getFaqItems(), getFaqCopy(), getPageHeader('faq')]);

function pad2(n: number) { return String(n).padStart(2, '0'); }
---

<Layout title={header?.title} description={header?.seo_description}>
  <PageHeader header={header} />

  <!-- FAQ — editorial accordion list -->
  <section class="max-w-3xl mx-auto px-5 sm:px-6 lg:px-8 py-20 sm:py-24">
    <ul class="divide-y divide-w-linen border-y border-w-linen">
      {faqItems.map((item, index) => (
        <li class={`fade-up delay-${(index % 5) * 100}`}>
          <details data-cms-collection="faq_items" data-cms-id={String(item.id)} class="group">
            <summary class="flex items-baseline justify-between gap-5 py-6 sm:py-7 cursor-pointer list-none select-none">
              <div class="flex items-baseline gap-4 sm:gap-5 flex-1 min-w-0">
                <span class="font-serif italic text-w-gold-dark text-lg sm:text-xl tabular-nums opacity-80">№{pad2(index + 1)}</span>
                <span data-cms-field="question" class="font-serif text-lg sm:text-xl font-medium text-w-dark leading-snug group-hover:text-w-gold-dark transition-colors">{item.question}</span>
              </div>
              <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center text-w-gold-dark transition-transform duration-300 group-open:rotate-45">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 5v14M5 12h14"/></svg>
              </span>
            </summary>
            <div class="pb-7 sm:pb-8 pl-12 sm:pl-14 pr-12 -mt-2">
              <p data-cms-field="answer" class="text-w-dark/75 leading-[1.85] text-[15px] sm:text-base font-light">{item.answer}</p>
            </div>
          </details>
        </li>
      ))}
    </ul>

    <div class="mt-20 text-center fade-up">
      <div class="inline-block text-w-gold-dark mb-5">
        <svg class="w-12 h-16"><use href="#m-wheat" /></svg>
      </div>
      <p data-cms-collection="faq_copy" data-cms-field="help_eyebrow" class="eyebrow mb-4">{copy.help_eyebrow}</p>
      <p data-cms-collection="faq_copy" data-cms-field="help_title" class="h-display text-w-dark text-3xl sm:text-4xl mb-4">{copy.help_title}</p>
      <p data-cms-collection="faq_copy" data-cms-field="help_text" class="text-w-stone text-base sm:text-lg mb-8 font-light max-w-md mx-auto leading-relaxed">{copy.help_text}</p>
      <a href={copy.help_cta_href} data-cms-collection="faq_copy" data-cms-field="help_cta_label" class="btn btn-gold">
        {copy.help_cta_label}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>
</Layout>
