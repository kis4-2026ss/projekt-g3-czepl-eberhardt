---
interface Props {
  eyebrow?: string;
  title: string;
  align?: 'center' | 'left';
  /** Roman numeral (I., II., III., …) shown as the editorial section marker. */
  numeral?: string;
  /** Render on a dark background. */
  onDark?: boolean;
  class?: string;
  cmsCollection?: string;
  cmsEyebrowField?: string;
  cmsTitleField?: string;
  cmsId?: string;
}
const {
  eyebrow, title, align = 'center', numeral, onDark = false, class: className = '',
  cmsCollection, cmsEyebrowField, cmsTitleField, cmsId,
} = Astro.props;

const wrap = align === 'center' ? 'text-center mx-auto items-center' : 'text-left items-start';
const eyeColor = onDark ? 'text-w-gold' : 'text-w-gold/95';
const numColor = onDark ? 'text-w-gold' : 'text-w-gold-dark';
const titleColor = onDark ? 'text-white' : 'text-w-dark';
---
<div class:list={[wrap, 'flex flex-col max-w-3xl', className, 'fade-up']}>
  {numeral && (
    <div class:list={['flex items-baseline gap-3 mb-5', align === 'center' ? 'justify-center' : '', numColor]}>
      <span class="font-serif italic text-4xl sm:text-5xl leading-none font-medium tracking-[0.02em]">{numeral}</span>
      <span class="h-px w-12 bg-current opacity-50 self-center"></span>
    </div>
  )}
  {eyebrow && (
    <p
      data-cms-collection={cmsCollection && cmsEyebrowField ? cmsCollection : undefined}
      data-cms-id={cmsCollection && cmsEyebrowField ? cmsId : undefined}
      data-cms-field={cmsCollection && cmsEyebrowField ? cmsEyebrowField : undefined}
      class:list={[
        'text-[11px] sm:text-xs font-semibold tracking-[0.36em] uppercase mb-4',
        eyeColor,
      ]}>
      {eyebrow}
    </p>
  )}
  <h2
    data-cms-collection={cmsCollection && cmsTitleField ? cmsCollection : undefined}
    data-cms-id={cmsCollection && cmsTitleField ? cmsId : undefined}
    data-cms-field={cmsCollection && cmsTitleField ? cmsTitleField : undefined}
    class:list={[
      'font-serif text-3xl sm:text-4xl lg:text-[2.85rem] leading-[1.1] font-medium tracking-tight',
      titleColor,
    ]}>
    {title}
  </h2>
</div>
