---
import type { NavigationLink, SiteSettings, UiCopy } from '../lib/directus';

interface Props {
  settings: SiteSettings;
  nav: NavigationLink[];
  ui: UiCopy;
}
const { settings, nav, ui } = Astro.props;

const year = new Date().getFullYear();

function tmpl(s: string, vars: Record<string, string>) {
  return s.replace(/\{(\w+)\}/g, (_m, k) => vars[k] ?? '');
}
---

<footer class="bg-w-dark text-white relative overflow-hidden">
  <!-- Decorative gold hairline -->
  <div class="h-px w-full bg-gradient-to-r from-transparent via-w-gold/60 to-transparent"></div>

  <div class="absolute inset-0 opacity-[0.025] pointer-events-none"
       style="background-image:radial-gradient(circle,#c69c6d 1px,transparent 1px);background-size:24px 24px"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 relative z-10 pt-20 sm:pt-24 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 mb-16">

      <!-- Brand -->
      <div class="md:col-span-5">
        <a href="/" class="group flex items-center gap-4 leading-tight mb-6">
          <span aria-hidden="true" class="w-12 h-12 rounded-full border border-w-gold/60 flex items-center justify-center text-w-gold font-serif text-xl">
            {settings.site_name.charAt(0)}
          </span>
          <span class="flex flex-col leading-tight">
            <span data-cms-collection="site_settings" data-cms-field="site_name" class="font-serif text-white text-2xl sm:text-3xl font-medium tracking-wide group-hover:text-w-gold transition-colors duration-300">
              {settings.site_name}
            </span>
            <span data-cms-collection="site_settings" data-cms-field="tagline" class="text-w-gold/90 text-[11px] tracking-[0.28em] uppercase mt-1">{settings.tagline}</span>
          </span>
        </a>
        <p data-cms-collection="site_settings" data-cms-field="footer_note" class="text-base font-light leading-relaxed text-white/60 max-w-md mb-8">{settings.footer_note}</p>
        <div class="flex gap-3">
          {settings.instagram_url && (
            <a href={settings.instagram_url} target="_blank" rel="noopener" aria-label="Instagram"
               class="w-10 h-10 flex items-center justify-center rounded-full border border-white/15 text-white/55 hover:text-w-gold hover:border-w-gold/60 transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          )}
          {settings.facebook_url && (
            <a href={settings.facebook_url} target="_blank" rel="noopener" aria-label="Facebook"
               class="w-10 h-10 flex items-center justify-center rounded-full border border-white/15 text-white/55 hover:text-w-gold hover:border-w-gold/60 transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Nav -->
      <div class="md:col-span-3">
        <p data-cms-collection="ui_copy" data-cms-field="footer_nav_title" class="text-w-gold text-xs font-semibold tracking-[0.28em] uppercase mb-6">{ui.footer_nav_title}</p>
        <ul class="space-y-3.5">
          {nav.map(l => (
            <li>
              <a href={l.href}
                 data-cms-collection="navigation_links"
                 data-cms-id={String(l.id)}
                 data-cms-field="label"
                 class="group inline-flex items-center gap-2 text-[15px] text-white/70 hover:text-white transition-colors font-light">
                <span class="w-0 h-px bg-w-gold transition-all duration-300 group-hover:w-4"></span>
                <span>{l.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="md:col-span-4">
        <p data-cms-collection="ui_copy" data-cms-field="footer_contact_title" class="text-w-gold text-xs font-semibold tracking-[0.28em] uppercase mb-6">{ui.footer_contact_title}</p>
        <address class="not-italic space-y-5 text-[15px] text-white/70 font-light">
          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 mt-1 flex-shrink-0 text-w-gold/80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>
              <span data-cms-collection="site_settings" data-cms-field="address_street">{settings.address_street}</span><br />
              <span data-cms-collection="site_settings" data-cms-field="address_zip">{settings.address_zip}</span> <span data-cms-collection="site_settings" data-cms-field="address_city">{settings.address_city}</span>
            </span>
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 mt-1 flex-shrink-0 text-w-gold/80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href={`tel:${settings.contact_phone.replace(/\s/g, '')}`}
               data-cms-collection="site_settings" data-cms-field="contact_phone"
               class="hover:text-white transition-colors">{settings.contact_phone}</a>
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 mt-1 flex-shrink-0 text-w-gold/80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href={`mailto:${settings.contact_email}`}
               data-cms-collection="site_settings" data-cms-field="contact_email"
               class="hover:text-white transition-colors break-all">{settings.contact_email}</a>
          </div>
          {settings.google_maps_url && (
            <a href={settings.google_maps_url} target="_blank" rel="noopener"
               data-cms-collection="ui_copy" data-cms-field="footer_maps_label"
               class="inline-link on-dark mt-2">
              {ui.footer_maps_label}
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          )}
        </address>
      </div>
    </div>

    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-4 text-[13px] text-white/45 font-light">
      <p data-cms-collection="ui_copy" data-cms-field="footer_rights_template">
        {tmpl(ui.footer_rights_template, {
          year: String(year),
          site_name: settings.site_name,
        })}
      </p>
      <p data-cms-collection="ui_copy" data-cms-field="footer_since_line" class="italic">{ui.footer_since_line}</p>
    </div>
  </div>
</footer>
