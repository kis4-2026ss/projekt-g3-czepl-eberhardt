---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'MCP Console',
  description = 'A conversational interface for any Directus instance, powered by MCP.',
} = Astro.props;
---

<!doctype html>
<html lang="de" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b10" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="h-full bg-surface text-zinc-100 font-sans antialiased selection:bg-brand/30 selection:text-zinc-50 overflow-hidden">
    <slot />

    <style is:global>
      :root {
        color-scheme: dark;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      html, body { height: 100%; }

      /* Subtle, technical-feeling backdrop — no warm gradients. */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background:
          radial-gradient(800px 600px at 15% 0%, rgba(99, 102, 241, 0.08), transparent 60%),
          radial-gradient(700px 500px at 85% 100%, rgba(129, 140, 248, 0.06), transparent 60%);
      }
      body::after {
        content: '';
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        opacity: 0.4;
        background-image:
          linear-gradient(rgba(63, 63, 70, 0.06) 1px, transparent 1px),
          linear-gradient(90deg, rgba(63, 63, 70, 0.06) 1px, transparent 1px);
        background-size: 32px 32px;
      }
      body > * { position: relative; z-index: 1; }

      :focus-visible {
        outline: 2px solid #818cf8;
        outline-offset: 2px;
        border-radius: 4px;
      }
      :focus:not(:focus-visible) { outline: none; }

      /* Scrollbars */
      .scroll-y::-webkit-scrollbar { width: 8px; }
      .scroll-y::-webkit-scrollbar-track { background: transparent; }
      .scroll-y::-webkit-scrollbar-thumb {
        background: rgba(99, 102, 241, 0.18);
        border-radius: 999px;
      }
      .scroll-y::-webkit-scrollbar-thumb:hover { background: rgba(99, 102, 241, 0.35); }

      /* Message bubble shared styles */
      .bubble-user {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: #ffffff;
        box-shadow: 0 8px 24px -12px rgba(99, 102, 241, 0.45);
      }
      .bubble-assistant {
        background: rgba(255, 255, 255, 0.025);
        border: 1px solid rgba(63, 63, 70, 0.6);
        backdrop-filter: blur(8px);
      }

      /* Prose-on-dark for assistant markdown */
      .prose-chat {
        color: rgba(244, 244, 245, 0.92);
        line-height: 1.7;
        font-size: 0.95rem;
      }
      .prose-chat p { margin: 0.5em 0; }
      .prose-chat p:first-child { margin-top: 0; }
      .prose-chat p:last-child { margin-bottom: 0; }
      .prose-chat strong { color: #fafafa; font-weight: 600; }
      .prose-chat em { color: #a5b4fc; }
      .prose-chat a { color: #a5b4fc; text-decoration: underline; text-underline-offset: 2px; }
      .prose-chat ul, .prose-chat ol { margin: 0.6em 0; padding-left: 1.25em; }
      .prose-chat li { margin: 0.2em 0; }
      .prose-chat ul li::marker { color: #818cf8; }
      .prose-chat ol li::marker { color: #818cf8; font-weight: 600; }
      .prose-chat h1, .prose-chat h2, .prose-chat h3, .prose-chat h4 {
        color: #fafafa;
        margin: 0.9em 0 0.4em;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .prose-chat h1 { font-size: 1.45em; }
      .prose-chat h2 { font-size: 1.25em; }
      .prose-chat h3 { font-size: 1.1em; }
      .prose-chat code {
        background: rgba(24, 24, 27, 0.8);
        border: 1px solid rgba(63, 63, 70, 0.6);
        color: #a5b4fc;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.85em;
        padding: 0.1em 0.4em;
        border-radius: 4px;
      }
      .prose-chat pre {
        background: rgba(9, 9, 11, 0.85);
        border: 1px solid rgba(63, 63, 70, 0.6);
        padding: 0.85em 1em;
        border-radius: 6px;
        overflow-x: auto;
        margin: 0.7em 0;
      }
      .prose-chat pre code {
        background: transparent;
        border: none;
        padding: 0;
        color: rgba(244, 244, 245, 0.92);
        font-size: 0.85em;
      }
      .prose-chat blockquote {
        border-left: 2px solid #818cf8;
        margin: 0.7em 0;
        padding: 0.2em 0 0.2em 1em;
        color: rgba(244, 244, 245, 0.75);
        font-style: italic;
      }
      .prose-chat table {
        width: 100%;
        border-collapse: collapse;
        margin: 0.7em 0;
        font-size: 0.9em;
      }
      .prose-chat th, .prose-chat td {
        border: 1px solid rgba(63, 63, 70, 0.6);
        padding: 0.4em 0.7em;
        text-align: left;
      }
      .prose-chat th { background: rgba(99, 102, 241, 0.08); color: #fafafa; font-weight: 600; }
      .prose-chat td { color: rgba(244, 244, 245, 0.85); }
      .prose-chat hr { border: none; border-top: 1px solid rgba(63, 63, 70, 0.6); margin: 1em 0; }

      /* Tool-call card */
      .tool-card {
        background: rgba(9, 9, 11, 0.6);
        border: 1px solid rgba(63, 63, 70, 0.6);
        border-radius: 8px;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.8rem;
      }
      .tool-card pre {
        margin: 0;
        padding: 0.7rem 0.9rem;
        white-space: pre-wrap;
        word-break: break-word;
        max-height: 14rem;
        overflow-y: auto;
        color: rgba(244, 244, 245, 0.82);
      }

      /* Typing dots */
      @keyframes dot-bounce {
        0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
        40% { transform: translateY(-4px); opacity: 1; }
      }
      .typing-dot {
        animation: dot-bounce 1.2s infinite ease-in-out;
      }
      .typing-dot:nth-child(2) { animation-delay: 0.15s; }
      .typing-dot:nth-child(3) { animation-delay: 0.3s; }

      /* Fade-in for messages */
      @keyframes msg-in {
        from { opacity: 0; transform: translateY(6px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .msg-in { animation: msg-in 0.35s cubic-bezier(.16,1,.3,1) both; }

      @media (prefers-reduced-motion: reduce) {
        .typing-dot, .msg-in { animation: none !important; }
      }
    </style>
  </body>
</html>
