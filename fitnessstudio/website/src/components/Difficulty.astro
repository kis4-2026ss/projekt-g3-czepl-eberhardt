---
import type { FitClass, UiCopy } from '../lib/directus';
import { difficultyDots, difficultyLabel } from '../lib/directus';

interface Props {
  level: FitClass['difficulty'];
  ui: UiCopy;
}
const { level, ui } = Astro.props;
const filled = difficultyDots(level);
const label  = difficultyLabel(level, ui);
---

<span class="inline-flex items-center gap-2 spec text-fc-muted" aria-label={label}>
  <span class="inline-flex items-center gap-0.5">
    {[0, 1, 2].map((i) => (
      <span class:list={[
        'w-2 h-2 inline-block',
        i < filled ? 'bg-fc-ink' : 'border border-fc-ink',
      ]}></span>
    ))}
  </span>
  <span class="text-fc-ink">{label}</span>
</span>
