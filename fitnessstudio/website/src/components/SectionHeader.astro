---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'center' | 'left';
  cmsCollection?: string;
  cmsEyebrowField?: string;
  cmsTitleField?: string;
  cmsLeadField?: string;
}
const {
  eyebrow, title, lead,
  align = 'center',
  cmsCollection,
  cmsEyebrowField,
  cmsTitleField,
  cmsLeadField,
} = Astro.props;
---

<div class:list={['flex flex-col max-w-2xl', align === 'center' ? 'items-center text-center mx-auto' : 'items-start']}>
  {eyebrow && (
    <span class="eyebrow mb-4"
          data-cms-collection={cmsCollection}
          data-cms-field={cmsEyebrowField}>
      {eyebrow}
    </span>
  )}
  <h2 class="font-display font-extrabold text-fs-dark text-3xl sm:text-4xl lg:text-5xl leading-[1.1] tracking-tight-2"
      data-cms-collection={cmsCollection}
      data-cms-field={cmsTitleField}>
    {title}
  </h2>
  {lead && (
    <p class="mt-4 text-fs-muted text-base sm:text-lg leading-relaxed"
       data-cms-collection={cmsCollection}
       data-cms-field={cmsLeadField}>
      {lead}
    </p>
  )}
</div>
