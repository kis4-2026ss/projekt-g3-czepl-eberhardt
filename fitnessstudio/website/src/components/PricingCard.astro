---
import type { MembershipPlan, UiCopy } from '../lib/directus';
import { formatPrice } from '../lib/directus';

interface Props {
  plan: MembershipPlan;
  ui: UiCopy;
  variant?: 'compact' | 'full';
  /** Optional index — adds an "01" marker */
  index?: string;
}
const { plan, ui, variant = 'compact', index } = Astro.props;
const highlighted = plan.is_highlighted;
---

<article
  data-cms-collection="membership_plans"
  data-cms-id={String(plan.id)}
  class:list={[
    'relative flex flex-col h-full p-8 sm:p-9 transition-all duration-300',
    highlighted
      ? 'bg-fc-ink text-white shadow-feature'
      : 'bg-fc-cream text-fc-ink border border-fc-ink',
  ]}>

  <!-- Index marker -->
  {index && (
    <span class:list={[
      'num-display text-3xl absolute top-6 right-6',
      highlighted ? 'text-fc-lime' : 'text-fc-ink/30',
    ]}>{index}</span>
  )}

  {highlighted && (
    <span class="absolute -top-3 left-6 sm:left-8 inline-flex items-center gap-1.5 bg-fc-lime text-fc-ink spec font-semibold px-3 py-1.5">
      <svg class="w-3 h-3"><use href="#fc-bolt" /></svg>
      <span data-cms-collection="membership_plans" data-cms-field="highlight_label">{plan.highlight_label || ui.popular_label}</span>
    </span>
  )}

  <header class="mb-8">
    <h3 data-cms-field="name" class:list={['font-display font-bold text-3xl sm:text-[2rem] leading-[1.05] tracking-tight-3 mb-2', highlighted ? 'text-white' : 'text-fc-ink']}>{plan.name}</h3>
    {plan.tagline && <p data-cms-field="tagline" class:list={['text-base leading-relaxed', highlighted ? 'text-white/65' : 'text-fc-muted']}>{plan.tagline}</p>}
  </header>

  <div class:list={['pb-7 mb-7 border-b', highlighted ? 'border-white/15' : 'border-fc-line']}>
    <div class="flex items-end gap-1">
      <span class:list={['num-display text-6xl sm:text-7xl tabular-nums', highlighted ? 'text-fc-lime' : 'text-fc-ink']}
            data-cms-field="price_monthly">€{formatPrice(plan.price_monthly)}</span>
    </div>
    <p class:list={['spec mt-2', highlighted ? 'text-white/55' : 'text-fc-muted']}>
      <span data-cms-collection="membership_plans" data-cms-field="billing_note">{plan.billing_note || ui.per_month_label}</span>
    </p>
  </div>

  <ul class="space-y-3.5 flex-1 mb-8">
    {(plan.features || []).map((f) => (
      <li class="flex items-start gap-3 text-[15px]">
        {f.included
          ? <svg class:list={['w-5 h-5 flex-shrink-0 mt-0.5', highlighted ? 'text-fc-lime' : 'text-fc-ink']} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M5 13l4 4L19 7"/></svg>
          : <svg class:list={['w-5 h-5 flex-shrink-0 mt-0.5', highlighted ? 'text-white/30' : 'text-fc-line']} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12"/></svg>}
        <span class:list={[
          'leading-snug',
          f.included
            ? (highlighted ? 'text-white' : 'text-fc-ink')
            : (highlighted ? 'text-white/35 line-through' : 'text-fc-muted line-through'),
        ]}>
          {f.label}
        </span>
      </li>
    ))}
  </ul>

  <a href={plan.cta_link || '#'}
     class:list={[
       'block w-full text-center btn',
       highlighted ? 'btn-lime' : 'btn-primary',
     ]}>
    <span data-cms-collection="membership_plans" data-cms-field="cta_label">{plan.cta_label}</span>
    <svg class="w-3 h-3"><use href="#fc-arrow" /></svg>
  </a>
</article>
