---
import type { NavigationLink, SiteSettings, UiCopy } from '../lib/directus';

interface Props {
  settings: SiteSettings;
  nav: NavigationLink[];
  ui: UiCopy;
}
const { settings, nav, ui } = Astro.props;

const path = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<header class="sticky top-0 inset-x-0 z-50 bg-fc-paper/95 backdrop-blur-md border-b border-transparent transition-all duration-200" id="main-nav">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">

      <!-- Brand wordmark -->
      <a href="/" class="group flex items-center gap-3 leading-tight">
        <span aria-hidden="true" class="w-9 h-9 bg-fc-ink text-fc-lime flex items-center justify-center transition-colors duration-300 group-hover:bg-fc-lime group-hover:text-fc-ink">
          <svg class="w-5 h-5"><use href="#fc-mark" /></svg>
        </span>
        <span class="flex items-baseline gap-2 leading-tight">
          <span data-cms-collection="site_settings" data-cms-field="site_name" class="font-display font-bold text-fc-ink text-[1.1rem] sm:text-[1.2rem] tracking-tight-2">
            {settings.site_name}
          </span>
          <span data-cms-collection="site_settings" data-cms-field="tagline" class="hidden lg:inline-block spec text-fc-muted">
            / {settings.tagline}
          </span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1">
        {nav.map(l => (
          <a
            href={l.href}
            data-cms-collection="navigation_links"
            data-cms-id={String(l.id)}
            data-cms-field="label"
            class:list={[
              'group relative px-3.5 py-2 text-[12.5px] font-medium uppercase tracking-[0.1em] transition-colors duration-200 font-mono',
              isActive(l.href) ? 'text-fc-ink' : 'text-fc-muted hover:text-fc-ink',
            ]}
          >
            {l.label}
            <span class:list={[
              'pointer-events-none absolute left-3.5 right-3.5 -bottom-0.5 h-0.5 bg-fc-ink transition-all duration-200',
              isActive(l.href) ? 'opacity-100 scale-x-100' : 'opacity-0 scale-x-50 group-hover:opacity-50 group-hover:scale-x-100',
            ]}></span>
          </a>
        ))}
        <a
          href={ui.nav_cta_href}
          data-cms-collection="ui_copy"
          data-cms-field="nav_cta_label"
          class="ml-4 btn btn-lime !py-2.5 !px-5 !text-[11px]"
        >
          {ui.nav_cta_label}
          <svg class="w-3 h-3"><use href="#fc-arrow" /></svg>
        </a>
      </nav>

      <!-- Mobile toggle -->
      <button id="nav-toggle" class="md:hidden text-fc-ink p-2 -mr-2 rounded-md hover:bg-fc-paper-2 transition-colors" aria-label="Menü" aria-expanded="false" aria-controls="nav-drawer">
        <svg id="icon-open"  class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="nav-drawer" class="hidden md:hidden border-t border-fc-line bg-fc-paper">
    <nav class="flex flex-col px-5 py-6 gap-1 max-h-[calc(100vh-4rem)] overflow-auto">
      {nav.map(l => (
        <a href={l.href}
           data-cms-collection="navigation_links"
           data-cms-id={String(l.id)}
           data-cms-field="label"
           class:list={[
             'flex items-center justify-between py-3.5 text-base font-display font-bold border-b border-fc-line transition-colors',
             isActive(l.href) ? 'text-fc-rust' : 'text-fc-ink hover:text-fc-rust',
           ]}>
          <span>{l.label}</span>
          <svg class="w-4 h-4 opacity-40"><use href="#fc-arrow" /></svg>
        </a>
      ))}
      <a href={ui.nav_cta_href}
         data-cms-collection="ui_copy"
         data-cms-field="nav_cta_label"
         class="mt-5 btn btn-lime">
        {ui.nav_cta_label}
        <svg class="w-3 h-3"><use href="#fc-arrow" /></svg>
      </a>
    </nav>
  </div>
</header>

<script>
  function setupNav() {
    const toggle  = document.getElementById('nav-toggle');
    const drawer  = document.getElementById('nav-drawer');
    const iconOpen  = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    const nav = document.getElementById('main-nav');
    if (!toggle || !drawer || !iconOpen || !iconClose || !nav) return;

    const newToggle = toggle.cloneNode(true) as HTMLButtonElement;
    toggle.parentNode?.replaceChild(newToggle, toggle);

    const open = () => {
      drawer.classList.remove('hidden');
      iconOpen.classList.add('hidden');
      iconClose.classList.remove('hidden');
      newToggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      drawer.classList.add('hidden');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      newToggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    newToggle.addEventListener('click', () => {
      drawer.classList.contains('hidden') ? open() : close();
    });

    drawer.querySelectorAll('a[href]').forEach(a => a.addEventListener('click', close));
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

    const onScroll = () => {
      if (window.scrollY > 8) {
        nav.classList.add('border-fc-line', 'shadow-sm');
      } else {
        nav.classList.remove('border-fc-line', 'shadow-sm');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  setupNav();
  document.addEventListener('astro:after-swap', setupNav);
</script>
