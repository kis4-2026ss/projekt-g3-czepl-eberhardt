---
import Layout from '../layouts/Layout.astro';
import {
  getSiteSettings, getOpeningHours, getUiCopy, getKontaktCopy,
} from '../lib/directus';

const [settings, hours, ui, copy] = await Promise.all([
  getSiteSettings(), getOpeningHours(), getUiCopy(), getKontaktCopy(),
]);
---

<Layout title={copy.title} description={copy.lead}>

  <!-- Page header -->
  <section class="bg-fs-surface border-b border-fs-border">
    <div class="max-w-4xl mx-auto px-5 sm:px-6 lg:px-8 pt-16 sm:pt-20 pb-12 text-center fade-up">
      <span class="eyebrow" data-cms-collection="kontakt_copy" data-cms-field="eyebrow">{copy.eyebrow}</span>
      <h1 class="display font-display font-extrabold text-fs-dark text-4xl sm:text-5xl lg:text-6xl mt-5 leading-[1.05] tracking-tight-2"
          data-cms-collection="kontakt_copy" data-cms-field="title">
        {copy.title}
      </h1>
      {copy.lead && (
        <p class="mt-5 text-fs-muted text-lg leading-relaxed max-w-2xl mx-auto"
           data-cms-collection="kontakt_copy" data-cms-field="lead">
          {copy.lead}
        </p>
      )}
    </div>
  </section>

  <!-- Two-column info -->
  <section class="section bg-fs-white">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">

      <!-- Info column -->
      <div class="fade-up">
        <h2 class="font-display font-extrabold text-fs-dark text-2xl sm:text-3xl tracking-tight-2 mb-8">
          {settings.site_name}
        </h2>

        <ul class="space-y-7">
          <li class="flex items-start gap-4" data-cms-collection="site_settings">
            <span class="flex-shrink-0 w-11 h-11 rounded-xl bg-fs-blue-bg flex items-center justify-center text-fs-blue">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </span>
            <div>
              <p data-cms-collection="ui_copy" data-cms-field="address_label"
                 class="text-fs-muted text-xs uppercase tracking-[0.14em] font-semibold mb-1.5">{ui.address_label}</p>
              <p class="text-fs-dark text-base leading-relaxed">
                <span data-cms-field="address_street">{settings.address_street}</span><br />
                <span data-cms-field="address_zip">{settings.address_zip}</span>
                {' '}
                <span data-cms-field="address_city">{settings.address_city}</span>
              </p>
              {settings.google_maps_url && (
                <a href={settings.google_maps_url} target="_blank" rel="noopener"
                   data-cms-collection="ui_copy" data-cms-field="directions_label"
                   class="inline-link mt-2.5">
                  {ui.directions_label}
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>
              )}
            </div>
          </li>

          <li class="flex items-start gap-4" data-cms-collection="site_settings">
            <span class="flex-shrink-0 w-11 h-11 rounded-xl bg-fs-blue-bg flex items-center justify-center text-fs-blue">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </span>
            <div>
              <p data-cms-collection="ui_copy" data-cms-field="phone_label"
                 class="text-fs-muted text-xs uppercase tracking-[0.14em] font-semibold mb-1.5">{ui.phone_label}</p>
              <a href={`tel:${settings.contact_phone.replace(/\s/g, '')}`}
                 data-cms-field="contact_phone"
                 class="text-fs-dark text-base hover:text-fs-blue transition-colors">
                {settings.contact_phone}
              </a>
            </div>
          </li>

          <li class="flex items-start gap-4" data-cms-collection="site_settings">
            <span class="flex-shrink-0 w-11 h-11 rounded-xl bg-fs-blue-bg flex items-center justify-center text-fs-blue">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </span>
            <div>
              <p data-cms-collection="ui_copy" data-cms-field="email_label"
                 class="text-fs-muted text-xs uppercase tracking-[0.14em] font-semibold mb-1.5">{ui.email_label}</p>
              <a href={`mailto:${settings.contact_email}`}
                 data-cms-field="contact_email"
                 class="text-fs-dark text-base hover:text-fs-blue transition-colors break-all">
                {settings.contact_email}
              </a>
            </div>
          </li>
        </ul>
      </div>

      <!-- Hours column -->
      <div class="fade-up delay-200">
        <div class="bg-fs-surface rounded-2xl p-7 sm:p-9 border border-fs-border">
          <h3 class="font-display font-extrabold text-fs-dark text-xl sm:text-2xl tracking-tight-2 mb-6"
              data-cms-collection="kontakt_copy" data-cms-field="hours_title">
            {copy.hours_title}
          </h3>
          <ul class="divide-y divide-fs-border">
            {hours.map(h => (
              <li data-cms-collection="opening_hours" data-cms-id={String(h.id)}
                  class:list={['flex items-center justify-between py-3.5', h.closed ? 'text-fs-muted' : 'text-fs-dark']}>
                <span data-cms-field="weekday" class="font-medium text-[15px]">{h.weekday}</span>
                {h.closed
                  ? <span data-cms-collection="ui_copy" data-cms-field="closed_label" class="text-sm italic line-through">{ui.closed_label}</span>
                  : (
                    <span class="text-sm tabular-nums font-medium">
                      <span data-cms-field="open_from">{h.open_from}</span>
                      <span class="text-fs-muted">–</span>
                      <span data-cms-field="open_to">{h.open_to}</span>
                    </span>
                  )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Trial banner -->
  <section class="section-tight bg-fs-white">
    <div class="max-w-3xl mx-auto px-5 sm:px-6 lg:px-8 fade-up">
      <div class="bg-fs-blue text-white rounded-2xl px-7 sm:px-10 py-8 sm:py-9 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 relative overflow-hidden">
        <div class="absolute inset-0 opacity-[0.07] pointer-events-none"
             style="background-image:radial-gradient(circle,#ffffff 1px,transparent 1px);background-size:24px 24px"></div>
        <div class="relative">
          <h3 class="font-display font-extrabold text-2xl sm:text-3xl tracking-tight-2"
              data-cms-collection="kontakt_copy" data-cms-field="trial_title">
            {copy.trial_title}
          </h3>
          <p class="mt-2 text-white/85"
             data-cms-collection="kontakt_copy" data-cms-field="trial_text">
            {copy.trial_text}
          </p>
        </div>
        <a href={copy.trial_link || `mailto:${settings.contact_email}`}
           data-cms-collection="kontakt_copy" data-cms-field="trial_cta"
           class="relative inline-flex items-center justify-center gap-2 bg-white text-fs-blue font-medium rounded-lg px-5 py-3 text-sm hover:bg-fs-blue-bg transition-colors whitespace-nowrap">
          {copy.trial_cta}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
