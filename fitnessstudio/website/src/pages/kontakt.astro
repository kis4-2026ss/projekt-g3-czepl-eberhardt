---
import Layout from '../layouts/Layout.astro';
import {
  getSiteSettings, getOpeningHours, getUiCopy, getKontaktCopy,
} from '../lib/directus';

const [settings, hours, ui, copy] = await Promise.all([
  getSiteSettings(), getOpeningHours(), getUiCopy(), getKontaktCopy(),
]);
---

<Layout title={copy.title} description={copy.lead}>

  <!-- Page header -->
  <section class="bg-fc-paper border-b border-fc-ink/15 relative overflow-hidden">
    <p class="absolute -right-6 top-2 num-display text-[clamp(8rem,22vw,16rem)] leading-[0.85] text-fc-ink/[0.05] select-none pointer-events-none" aria-hidden="true">03</p>
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 pt-20 sm:pt-24 pb-14 fade-up relative">
      <div class="flex items-baseline gap-4 mb-5">
        <span class="num-display text-4xl sm:text-5xl text-fc-ink">03</span>
        <span class="eyebrow" data-cms-collection="kontakt_copy" data-cms-field="eyebrow">{copy.eyebrow}</span>
      </div>
      <h1 class="h-mega text-fc-ink text-5xl sm:text-7xl lg:text-[6.5rem] max-w-4xl"
          data-cms-collection="kontakt_copy" data-cms-field="title">
        {copy.title}
      </h1>
      {copy.lead && (
        <p class="mt-7 text-fc-muted text-lg sm:text-xl leading-relaxed max-w-2xl"
           data-cms-collection="kontakt_copy" data-cms-field="lead">
          {copy.lead}
        </p>
      )}
    </div>
  </section>

  <!-- Two-column info -->
  <section class="section bg-fc-paper">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">

      <!-- Info column -->
      <div class="lg:col-span-7 fade-up">
        <h2 class="font-display font-bold text-fc-ink text-3xl tracking-tight-3 mb-10">
          {settings.site_name}
        </h2>

        <ul class="space-y-8 border-t border-fc-ink/15">
          <li class="grid grid-cols-[5rem_1fr] sm:grid-cols-[6rem_1fr] gap-6 items-baseline pt-8 border-b border-fc-ink/15 pb-8" data-cms-collection="site_settings">
            <span class="spec text-fc-rust">/ 01</span>
            <div>
              <p data-cms-collection="ui_copy" data-cms-field="address_label"
                 class="spec text-fc-muted mb-2">{ui.address_label}</p>
              <p class="font-display font-bold text-fc-ink text-2xl leading-tight">
                <span data-cms-field="address_street">{settings.address_street}</span><br />
                <span data-cms-field="address_zip">{settings.address_zip}</span>
                {' '}
                <span data-cms-field="address_city">{settings.address_city}</span>
              </p>
              {settings.google_maps_url && (
                <a href={settings.google_maps_url} target="_blank" rel="noopener"
                   data-cms-collection="ui_copy" data-cms-field="directions_label"
                   class="inline-link mt-4">
                  {ui.directions_label}
                  <svg class="w-3.5 h-3.5"><use href="#fc-arrow" /></svg>
                </a>
              )}
            </div>
          </li>

          <li class="grid grid-cols-[5rem_1fr] sm:grid-cols-[6rem_1fr] gap-6 items-baseline pt-0 border-b border-fc-ink/15 pb-8" data-cms-collection="site_settings">
            <span class="spec text-fc-rust">/ 02</span>
            <div>
              <p data-cms-collection="ui_copy" data-cms-field="phone_label"
                 class="spec text-fc-muted mb-2">{ui.phone_label}</p>
              <a href={`tel:${settings.contact_phone.replace(/\s/g, '')}`}
                 data-cms-field="contact_phone"
                 class="font-display font-bold text-fc-ink text-2xl sm:text-3xl tabular-nums hover:text-fc-rust transition-colors">
                {settings.contact_phone}
              </a>
            </div>
          </li>

          <li class="grid grid-cols-[5rem_1fr] sm:grid-cols-[6rem_1fr] gap-6 items-baseline pt-0 pb-2" data-cms-collection="site_settings">
            <span class="spec text-fc-rust">/ 03</span>
            <div>
              <p data-cms-collection="ui_copy" data-cms-field="email_label"
                 class="spec text-fc-muted mb-2">{ui.email_label}</p>
              <a href={`mailto:${settings.contact_email}`}
                 data-cms-field="contact_email"
                 class="font-display font-bold text-fc-ink text-xl sm:text-2xl hover:text-fc-rust transition-colors break-all">
                {settings.contact_email}
              </a>
            </div>
          </li>
        </ul>
      </div>

      <!-- Hours column -->
      <div class="lg:col-span-5 fade-up delay-200">
        <div class="bg-fc-ink text-white p-8 sm:p-10 relative overflow-hidden">
          <p class="absolute -right-3 -top-3 num-display text-[8rem] leading-none text-white/[0.06] select-none pointer-events-none" aria-hidden="true">04</p>
          <div class="relative">
            <span class="eyebrow on-ink mb-4">[ 04 ] Schedule</span>
            <h3 class="font-display font-bold text-3xl sm:text-4xl tracking-tight-3 mb-8 mt-3"
                data-cms-collection="kontakt_copy" data-cms-field="hours_title">
              {copy.hours_title}
            </h3>
            <ul class="divide-y divide-white/15 border-y border-white/20">
              {hours.map(h => (
                <li data-cms-collection="opening_hours" data-cms-id={String(h.id)}
                    class:list={['flex items-baseline justify-between py-4', h.closed ? 'opacity-50' : '']}>
                  <span data-cms-field="weekday" class="spec text-fc-lime">{h.weekday}</span>
                  {h.closed
                    ? <span data-cms-collection="ui_copy" data-cms-field="closed_label" class="font-display italic text-white/55">{ui.closed_label}</span>
                    : (
                      <span class="num-display text-xl sm:text-2xl tabular-nums">
                        <span data-cms-field="open_from">{h.open_from}</span>
                        <span class="text-white/30 mx-1">—</span>
                        <span data-cms-field="open_to">{h.open_to}</span>
                      </span>
                    )}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trial banner -->
  <section class="bg-fc-lime relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-16 sm:py-20 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center fade-up">
      <div class="lg:col-span-8">
        <span class="spec text-fc-ink/70 mb-5 inline-block">[ Trial ]</span>
        <h3 class="h-mega text-fc-ink text-4xl sm:text-5xl lg:text-6xl mt-3"
            data-cms-collection="kontakt_copy" data-cms-field="trial_title">
          {copy.trial_title}
        </h3>
        <p class="mt-5 text-fc-ink/80 text-lg max-w-xl"
           data-cms-collection="kontakt_copy" data-cms-field="trial_text">
          {copy.trial_text}
        </p>
      </div>
      <div class="lg:col-span-4 lg:justify-self-end">
        <a href={copy.trial_link || `mailto:${settings.contact_email}`}
           data-cms-collection="kontakt_copy" data-cms-field="trial_cta"
           class="btn btn-primary">
          {copy.trial_cta}
          <svg class="w-3.5 h-3.5"><use href="#fc-arrow" /></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
