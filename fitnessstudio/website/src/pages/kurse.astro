---
import Layout from '../layouts/Layout.astro';
import ClassCard from '../components/ClassCard.astro';
import {
  getClasses, getClassCategories, getUiCopy, getKurseCopy,
} from '../lib/directus';

const [classes, categories, ui, copy] = await Promise.all([
  getClasses(), getClassCategories(), getUiCopy(), getKurseCopy(),
]);

function pad2(n: number) { return String(n).padStart(2, '0'); }
---

<Layout title={copy.title} description={copy.lead}>

  <!-- Page header -->
  <section class="bg-fc-paper border-b border-fc-ink/15 relative overflow-hidden">
    <p class="absolute -right-6 top-2 num-display text-[clamp(8rem,22vw,16rem)] leading-[0.85] text-fc-ink/[0.05] select-none pointer-events-none" aria-hidden="true">01</p>
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 pt-20 sm:pt-24 pb-14 fade-up relative">
      <div class="flex items-baseline gap-4 mb-5">
        <span class="num-display text-4xl sm:text-5xl text-fc-ink">01</span>
        <span class="eyebrow" data-cms-collection="kurse_copy" data-cms-field="eyebrow">{copy.eyebrow}</span>
      </div>
      <h1 class="h-mega text-fc-ink text-5xl sm:text-7xl lg:text-[6.5rem] max-w-4xl"
          data-cms-collection="kurse_copy" data-cms-field="title">
        {copy.title}
      </h1>
      {copy.lead && (
        <p class="mt-7 text-fc-muted text-lg sm:text-xl leading-relaxed max-w-2xl"
           data-cms-collection="kurse_copy" data-cms-field="lead">
          {copy.lead}
        </p>
      )}
    </div>
  </section>

  <!-- Filter bar -->
  <section class="sticky top-16 sm:top-20 z-30 bg-fc-paper/95 backdrop-blur-md border-b border-fc-ink/15">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div id="filter-bar" class="flex gap-1.5 overflow-x-auto scrollbar-hide py-4">
        <button
          type="button"
          data-filter="all"
          class="filter-pill active flex-shrink-0 px-4 py-2 border border-fc-ink bg-fc-ink text-fc-lime spec font-medium transition-all duration-200 whitespace-nowrap">
          <span data-cms-collection="ui_copy" data-cms-field="all_categories_label">{ui.all_categories_label}</span>
        </button>
        {categories.map(c => (
          <button
            type="button"
            data-filter={c.slug}
            class="filter-pill flex-shrink-0 px-4 py-2 border border-fc-ink bg-transparent text-fc-ink spec font-medium hover:bg-fc-ink hover:text-fc-lime transition-all duration-200 whitespace-nowrap">
            <span data-cms-collection="class_categories" data-cms-id={String(c.id)} data-cms-field="name">{c.name}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Classes grid -->
  <section class="section bg-fc-paper">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div id="classes-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
        {classes.map((c, i) => (
          <div class={`class-item fade-up delay-${((i % 3) + 1) * 100}`}
               data-category={c.category?.slug ?? ''}>
            <ClassCard item={c} ui={ui} showSchedule={true} index={`/ ${pad2(i + 1)}`} />
          </div>
        ))}
      </div>
      {classes.length === 0 && (
        <div class="text-center py-20 spec text-fc-muted">
          Aktuell keine Kurse hinterlegt.
        </div>
      )}
    </div>
  </section>
</Layout>

<script>
  function setupKurseFilter() {
    const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const items = document.querySelectorAll<HTMLElement>('.class-item');
    if (!pills.length || !items.length) return;

    const setActive = (filter: string) => {
      pills.forEach((p) => {
        const isActive = p.dataset.filter === filter;
        p.classList.toggle('active', isActive);
        p.classList.toggle('bg-fc-ink', isActive);
        p.classList.toggle('text-fc-lime', isActive);
        p.classList.toggle('bg-transparent', !isActive);
        p.classList.toggle('text-fc-ink', !isActive);
      });

      items.forEach((el) => {
        const cat = el.dataset.category ?? '';
        const visible = filter === 'all' || cat === filter;
        el.style.display = visible ? '' : 'none';
      });
    };

    pills.forEach((p) => {
      p.addEventListener('click', () => {
        const filter = p.dataset.filter || 'all';
        setActive(filter);
      });
    });
  }

  setupKurseFilter();
  document.addEventListener('astro:after-swap', setupKurseFilter);
</script>
