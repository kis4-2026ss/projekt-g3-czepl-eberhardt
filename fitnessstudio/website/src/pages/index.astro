---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ClassCard from '../components/ClassCard.astro';
import PricingCard from '../components/PricingCard.astro';
import {
  getHero, getAbout, getFeaturedClasses, getMembershipPlans,
  getTestimonials, getOpeningHours, getHomeCopy, getUiCopy,
  getSiteStats, getSiteSettings, assetUrl,
} from '../lib/directus';

const [hero, about, classes, plans, testimonials, hours, home, ui, stats, settings] = await Promise.all([
  getHero(), getAbout(), getFeaturedClasses(), getMembershipPlans(),
  getTestimonials(), getOpeningHours(), getHomeCopy(), getUiCopy(),
  getSiteStats(), getSiteSettings(),
]);

function stars(n: number) { return '★'.repeat(n) + '☆'.repeat(5 - n); }
function pad2(n: number | string) { return String(n).padStart(2, '0'); }

// Marquee terms — generic "strength · mobility · cardio" feel
const marqueeTerms = ['Strength', 'Mobility', 'Cardio', 'Power', 'Endurance', 'Recovery'];
const marqueeLoop = [...marqueeTerms, ...marqueeTerms, ...marqueeTerms];
---

<Layout title={settings.site_name} description={hero.subheadline}>

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section data-cms-collection="hero" class="relative bg-fc-paper overflow-hidden">

    <!-- Mega background wordmark — kinetic, sits behind the content -->
    <p class="absolute -top-10 sm:top-2 -right-6 sm:-right-10 h-mega text-[clamp(8rem,28vw,22rem)] leading-[0.85] text-fc-ink/[0.04] select-none pointer-events-none whitespace-nowrap" aria-hidden="true">
      FITCORE.
    </p>

    <div class="relative max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 pt-10 sm:pt-14 lg:pt-20 pb-16 sm:pb-20 lg:pb-24">

      <!-- Top spec strip -->
      <div class="flex flex-wrap items-baseline gap-4 sm:gap-8 mb-12 sm:mb-16 fade-up">
        <span class="spec text-fc-ink flex items-center gap-2">
          <svg class="w-2 h-2 text-fc-rust"><use href="#fc-cross" /></svg>
          <span data-cms-collection="hero" data-cms-field="eyebrow">{hero.eyebrow}</span>
        </span>
        <span class="spec text-fc-muted">/ Est. <span data-cms-collection="site_stats" data-cms-field="founded_year">{stats.founded_year}</span></span>
        <span class="spec text-fc-muted">/ <span data-cms-collection="site_settings" data-cms-field="address_city">{settings.address_city}</span></span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">

        <!-- Headline column -->
        <div class="lg:col-span-7 fade-up">
          <h1 data-cms-collection="hero" data-cms-field="headline"
              class="h-mega text-fc-ink text-[3rem] sm:text-[5rem] lg:text-[7rem] xl:text-[8rem]">
            {hero.headline}
          </h1>
          {hero.subheadline && (
            <p data-cms-collection="hero" data-cms-field="subheadline"
               class="mt-8 text-fc-muted text-lg sm:text-xl leading-[1.55] max-w-xl fade-up delay-100">
              {hero.subheadline}
            </p>
          )}
          <div class="mt-10 flex flex-wrap gap-3 sm:gap-4 fade-up delay-200">
            {hero.cta_primary_label && (
              <a href={hero.cta_primary_link}
                 data-cms-collection="hero" data-cms-field="cta_primary_label"
                 class="btn btn-lime">
                {hero.cta_primary_label}
                <svg class="w-3.5 h-3.5"><use href="#fc-arrow" /></svg>
              </a>
            )}
            {hero.cta_secondary_label && (
              <a href={hero.cta_secondary_link}
                 data-cms-collection="hero" data-cms-field="cta_secondary_label"
                 class="btn btn-ghost">
                {hero.cta_secondary_label}
              </a>
            )}
          </div>
        </div>

        <!-- Image column with stat-bar overlay -->
        <div class="lg:col-span-5 fade-up delay-300">
          <div class="relative aspect-[4/5] bg-fc-paper-2 overflow-hidden">
            {hero.image
              ? <img src={assetUrl(hero.image, 'width=1200&quality=82&fit=cover')}
                     alt={hero.image_alt}
                     data-cms-collection="hero" data-cms-field="image"
                     class="w-full h-full object-cover" />
              : <div class="w-full h-full bg-fc-paper-2"></div>}
            <!-- Index marker -->
            <span class="absolute top-4 left-4 num-display bg-fc-ink text-fc-lime px-3 py-1.5 text-xl">/ 01</span>
            <!-- Rating chip — kinetic style -->
            <div class="absolute bottom-4 left-4 right-4 bg-fc-ink text-white px-5 py-4 flex items-center justify-between gap-4">
              <div>
                <p class="spec text-fc-lime">Member Rating</p>
                <p class="font-display font-bold text-2xl mt-0.5">
                  <span data-cms-collection="site_stats" data-cms-field="rating">{stats.rating}</span>
                  <span class="text-white/55 text-base font-medium ml-1">/ 5.0</span>
                </p>
              </div>
              <p class="text-fc-lime text-xl tracking-[0.25em]">★★★★★</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stats bar (3 cells) — sits under hero on a thin rule -->
      <div data-cms-collection="site_stats" class="mt-16 sm:mt-20 grid grid-cols-3 border-t border-fc-ink fade-up delay-300">
        <div class="py-6 sm:py-8 pr-4 sm:pr-8 border-r border-fc-ink/15">
          <p class="spec text-fc-muted">[ 01 ] Member</p>
          <p data-cms-field="member_count" class="num-display text-4xl sm:text-6xl mt-2 text-fc-ink">{stats.member_count}</p>
          <p data-cms-field="member_label" class="spec mt-2 text-fc-ink">{stats.member_label}</p>
        </div>
        <div class="py-6 sm:py-8 px-4 sm:px-8 border-r border-fc-ink/15">
          <p class="spec text-fc-muted">[ 02 ] Pro Woche</p>
          <p data-cms-field="courses_per_week" class="num-display text-4xl sm:text-6xl mt-2 text-fc-ink">{stats.courses_per_week}</p>
          <p data-cms-field="courses_label" class="spec mt-2 text-fc-ink">{stats.courses_label}</p>
        </div>
        <div class="py-6 sm:py-8 pl-4 sm:pl-8">
          <p class="spec text-fc-muted">[ 03 ] Team</p>
          <p data-cms-field="trainer_count" class="num-display text-4xl sm:text-6xl mt-2 text-fc-ink">{stats.trainer_count}</p>
          <p data-cms-field="trainer_label" class="spec mt-2 text-fc-ink">{stats.trainer_label}</p>
        </div>
      </div>
    </div>

    <!-- Marquee bar — bold green block, kinetic -->
    <div class="bg-fc-lime border-y border-fc-ink marquee-wrap overflow-hidden">
      <div class="marquee py-4">
        {marqueeLoop.map((term) => (
          <span class="flex items-center gap-12 whitespace-nowrap font-display font-bold text-fc-ink text-3xl sm:text-4xl tracking-tight-3">
            <span>{term}.</span>
            <svg class="w-3.5 h-3.5 text-fc-ink/50 flex-shrink-0"><use href="#fc-cross" /></svg>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ── KURSE / CLASSES ─────────────────────────────────────── -->
  <section id="kurse" class="section bg-fc-paper">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-14 sm:mb-16 fade-up">
        <div class="lg:col-span-7">
          <SectionHeader
            index="01"
            eyebrow={home.classes_eyebrow}
            title={home.classes_title}
            lead={home.classes_lead}
            cmsCollection="home_copy"
            cmsEyebrowField="classes_eyebrow"
            cmsTitleField="classes_title"
            cmsLeadField="classes_lead" />
        </div>
        <div class="lg:col-span-5 flex lg:items-end lg:justify-end">
          <a href="/kurse" data-cms-collection="home_copy" data-cms-field="classes_all_link_label" class="inline-link">
            {home.classes_all_link_label}
            <svg class="w-3.5 h-3.5"><use href="#fc-arrow" /></svg>
          </a>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
        {classes.slice(0, 3).map((c, i) => (
          <div class={`fade-up delay-${(i + 1) * 100}`}>
            <ClassCard item={c} ui={ui} index={`/ ${pad2(i + 1)}`} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── ABOUT — bold editorial split ─────────────────────────── -->
  <section class="section bg-fc-cream relative overflow-hidden">
    <!-- Big bg numeral 02 -->
    <p class="absolute -left-6 top-10 num-display text-[clamp(10rem,28vw,22rem)] leading-[0.85] text-fc-ink/[0.05] select-none pointer-events-none" aria-hidden="true">02</p>

    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start relative">

      <!-- Image -->
      <div class="lg:col-span-5 fade-up">
        <div class="relative aspect-[4/5] overflow-hidden bg-fc-paper-2 border border-fc-ink">
          {about.image
            ? <img src={assetUrl(about.image, 'width=900&quality=82&fit=cover')}
                   alt={about.image_alt}
                   data-cms-collection="about" data-cms-field="image"
                   class="w-full h-full object-cover" />
            : <div class="w-full h-full bg-fc-paper-2"></div>}
        </div>
        <!-- Stat row beneath image -->
        <dl data-cms-collection="site_stats" class="mt-4 grid grid-cols-2 gap-0 border border-fc-ink border-t-0 divide-x divide-fc-ink">
          <div class="p-5">
            <dt class="spec text-fc-muted">Founded</dt>
            <dd data-cms-field="founded_year" class="num-display text-3xl text-fc-ink mt-1">{stats.founded_year}</dd>
          </div>
          <div class="p-5">
            <dt class="spec text-fc-muted">Studio</dt>
            <dd data-cms-field="studio_area" class="num-display text-3xl text-fc-ink mt-1">{stats.studio_area}</dd>
          </div>
        </dl>
      </div>

      <!-- Text -->
      <div class="lg:col-span-7 fade-up delay-100" data-cms-collection="about">
        <span class="eyebrow mb-5" data-cms-field="eyebrow">[ 02 ] {about.eyebrow}</span>
        <h2 data-cms-field="title" class="mt-5 h-mega text-fc-ink text-4xl sm:text-5xl lg:text-[3.75rem] leading-[1.02]">
          {about.title}
        </h2>
        {about.lead && (
          <p data-cms-field="lead" class="mt-7 text-fc-ink text-lg leading-relaxed max-w-xl">
            {about.lead}
          </p>
        )}
        {about.body && (
          <p data-cms-field="body" class="mt-5 text-fc-muted text-base leading-[1.75] max-w-xl">
            {about.body}
          </p>
        )}
        {about.team_link_label && (
          <a href={about.team_link_href || '#'} data-cms-field="team_link_label" class="inline-link mt-8">
            {about.team_link_label}
            <svg class="w-3.5 h-3.5"><use href="#fc-arrow" /></svg>
          </a>
        )}

        <!-- Big inline stat callout -->
        <div data-cms-collection="site_stats" class="mt-10 pt-10 border-t border-fc-ink/15 grid grid-cols-2 gap-6">
          <div>
            <p data-cms-field="rating" class="num-display text-5xl sm:text-6xl text-fc-ink">{stats.rating}<span class="text-fc-ink/30 text-3xl">/5</span></p>
            <p data-cms-field="rating_label" class="spec mt-2 text-fc-muted">{stats.rating_label}</p>
          </div>
          <div>
            <p data-cms-field="trainer_about_count" class="num-display text-5xl sm:text-6xl text-fc-ink">{stats.trainer_about_count}</p>
            <p data-cms-field="trainer_about_label" class="spec mt-2 text-fc-muted">{stats.trainer_about_label}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── MEMBERSHIPS ─────────────────────────────────────────── -->
  <section class="section bg-fc-ink text-white relative overflow-hidden">
    <p class="absolute -left-6 top-6 num-display text-[clamp(8rem,22vw,18rem)] leading-[0.85] text-white/[0.05] select-none pointer-events-none" aria-hidden="true">03</p>

    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-14 sm:mb-16 fade-up">
        <div class="lg:col-span-7">
          <SectionHeader
            index="03"
            onInk={true}
            eyebrow={home.pricing_eyebrow}
            title={home.pricing_title}
            lead={home.pricing_lead}
            cmsCollection="home_copy"
            cmsEyebrowField="pricing_eyebrow"
            cmsTitleField="pricing_title"
            cmsLeadField="pricing_lead" />
        </div>
        <div class="lg:col-span-5 flex lg:items-end lg:justify-end">
          <a href="/mitgliedschaft" data-cms-collection="home_copy" data-cms-field="pricing_all_link_label" class="inline-link on-ink">
            {home.pricing_all_link_label}
            <svg class="w-3.5 h-3.5"><use href="#fc-arrow" /></svg>
          </a>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-7 max-w-6xl mx-auto pt-4">
        {plans.slice(0, 3).map((p, i) => (
          <div class={`fade-up delay-${(i + 1) * 100}`}>
            <PricingCard plan={p} ui={ui} index={`/ ${pad2(i + 1)}`} />
          </div>
        ))}
      </div>
      <p class="text-center mt-10 spec text-white/60 fade-up delay-300"
         data-cms-collection="home_copy" data-cms-field="pricing_footnote">
        {home.pricing_footnote}
      </p>
    </div>
  </section>

  <!-- ── TESTIMONIALS — pull-quote single column ──────────────── -->
  <section class="section bg-fc-paper relative overflow-hidden">
    <p class="absolute -right-6 top-6 num-display text-[clamp(8rem,22vw,18rem)] leading-[0.85] text-fc-ink/[0.05] select-none pointer-events-none" aria-hidden="true">04</p>

    <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-4 fade-up">
          <SectionHeader
            index="04"
            eyebrow={home.testimonials_eyebrow}
            title={home.testimonials_title}
            cmsCollection="home_copy"
            cmsEyebrowField="testimonials_eyebrow"
            cmsTitleField="testimonials_title" />
        </div>
        <div class="lg:col-span-8 space-y-10">
          {testimonials.slice(0, 3).map((t, i) => (
            <blockquote
              data-cms-collection="testimonials"
              data-cms-id={String(t.id)}
              class={`fade-up delay-${(i + 1) * 100} ${i > 0 ? 'pt-10 border-t border-fc-ink/15' : ''}`}>
              <div class="flex items-baseline gap-5 mb-4">
                <span class="num-display text-fc-rust text-2xl">/ {pad2(i + 1)}</span>
                <p data-cms-field="rating" class="text-fc-ink tracking-[0.25em]">{stars(t.rating)}</p>
                <span class="h-px flex-1 bg-fc-ink/15"></span>
                <p data-cms-field="membership_type" class="spec text-fc-muted">{t.membership_type}</p>
              </div>
              <p data-cms-field="quote" class="font-display font-medium text-fc-ink text-2xl sm:text-[1.8rem] leading-[1.25] tracking-tight-2">
                “{t.quote}”
              </p>
              <footer class="mt-4">
                <p data-cms-field="author" class="spec text-fc-ink">— {t.author}</p>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── OPENING HOURS — editorial tabular schedule ──────────── -->
  <section class="section bg-fc-cream relative overflow-hidden">
    <p class="absolute -left-6 top-6 num-display text-[clamp(8rem,22vw,18rem)] leading-[0.85] text-fc-ink/[0.05] select-none pointer-events-none" aria-hidden="true">05</p>

    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-5 fade-up">
          <SectionHeader
            index="05"
            eyebrow={home.hours_eyebrow}
            title={home.hours_title}
            cmsCollection="home_copy"
            cmsEyebrowField="hours_eyebrow"
            cmsTitleField="hours_title" />
          <a href={`tel:${settings.contact_phone.replace(/\s/g, '')}`}
             data-cms-collection="home_copy" data-cms-field="hours_cta_label"
             class="inline-link mt-8">
            {home.hours_cta_label}
            <svg class="w-3.5 h-3.5"><use href="#fc-arrow" /></svg>
          </a>
        </div>
        <ul class="lg:col-span-7 divide-y divide-fc-ink/15 border-y border-fc-ink fade-up delay-100">
          {hours.map(h => (
            <li data-cms-collection="opening_hours" data-cms-id={String(h.id)}
                class:list={[
                  'grid grid-cols-[5.5rem_1fr_auto] sm:grid-cols-[8rem_1fr_auto] items-baseline gap-6 py-5',
                  h.closed ? 'opacity-50' : '',
                ]}>
              <p data-cms-field="weekday" class="spec text-fc-ink">{h.weekday}</p>
              {h.closed ? (
                <p data-cms-collection="ui_copy" data-cms-field="closed_label" class="num-display text-2xl text-fc-muted italic font-normal">{ui.closed_label}</p>
              ) : (
                <p class="num-display text-2xl sm:text-3xl text-fc-ink tabular-nums">
                  <span data-cms-field="open_from">{h.open_from}</span>
                  <span class="text-fc-ink/30 mx-2">—</span>
                  <span data-cms-field="open_to">{h.open_to}</span>
                </p>
              )}
              {!h.closed && h.note ? (
                <span data-cms-field="note" class="spec text-fc-rust whitespace-nowrap">{h.note}</span>
              ) : <span></span>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

</Layout>
