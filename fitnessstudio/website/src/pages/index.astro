---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ClassCard from '../components/ClassCard.astro';
import PricingCard from '../components/PricingCard.astro';
import {
  getHero, getAbout, getFeaturedClasses, getMembershipPlans,
  getTestimonials, getOpeningHours, getHomeCopy, getUiCopy,
  getSiteStats, getSiteSettings, assetUrl,
} from '../lib/directus';

const [hero, about, classes, plans, testimonials, hours, home, ui, stats, settings] = await Promise.all([
  getHero(), getAbout(), getFeaturedClasses(), getMembershipPlans(),
  getTestimonials(), getOpeningHours(), getHomeCopy(), getUiCopy(),
  getSiteStats(), getSiteSettings(),
]);

function stars(n: number) { return '★'.repeat(n) + '☆'.repeat(5 - n); }
---

<Layout title={settings.site_name} description={hero.subheadline}>

  <!-- ── Hero ────────────────────────────────────────────────── -->
  <section data-cms-collection="hero" class="bg-fs-white border-b border-fs-border/60 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 pt-12 sm:pt-16 lg:pt-24 pb-16 sm:pb-20 lg:pb-28 min-h-[88vh] flex items-center">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center w-full">

        <!-- Text column -->
        <div class="lg:col-span-6 fade-up">
          {hero.eyebrow && (
            <span data-cms-collection="hero" data-cms-field="eyebrow" class="eyebrow mb-6">
              {hero.eyebrow}
            </span>
          )}
          <h1 data-cms-collection="hero" data-cms-field="headline"
              class="display font-display font-extrabold text-fs-dark text-[2.5rem] sm:text-5xl lg:text-[3.75rem] xl:text-[4.25rem] leading-[1.05] tracking-tight-2 mt-2">
            {hero.headline}
          </h1>
          {hero.subheadline && (
            <p data-cms-collection="hero" data-cms-field="subheadline"
               class="mt-6 text-fs-muted text-lg leading-relaxed max-w-xl">
              {hero.subheadline}
            </p>
          )}
          <div class="mt-8 flex flex-wrap gap-3">
            {hero.cta_primary_label && (
              <a href={hero.cta_primary_link}
                 data-cms-collection="hero" data-cms-field="cta_primary_label"
                 class="btn btn-primary">
                {hero.cta_primary_label}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            )}
            {hero.cta_secondary_label && (
              <a href={hero.cta_secondary_link}
                 data-cms-collection="hero" data-cms-field="cta_secondary_label"
                 class="btn btn-ghost">
                {hero.cta_secondary_label}
              </a>
            )}
          </div>

          <!-- Stats row -->
          <div data-cms-collection="site_stats" class="mt-12 grid grid-cols-3 max-w-lg divide-x divide-fs-border">
            <div class="pr-6">
              <p data-cms-field="member_count" class="font-display font-extrabold text-fs-blue text-2xl sm:text-3xl tracking-tight-2">{stats.member_count}</p>
              <p data-cms-field="member_label" class="text-fs-muted text-xs mt-1 uppercase tracking-[0.1em] font-semibold">{stats.member_label}</p>
            </div>
            <div class="px-6">
              <p data-cms-field="courses_per_week" class="font-display font-extrabold text-fs-blue text-2xl sm:text-3xl tracking-tight-2">{stats.courses_per_week}</p>
              <p data-cms-field="courses_label" class="text-fs-muted text-xs mt-1 uppercase tracking-[0.1em] font-semibold">{stats.courses_label}</p>
            </div>
            <div class="pl-6">
              <p data-cms-field="trainer_count" class="font-display font-extrabold text-fs-blue text-2xl sm:text-3xl tracking-tight-2">{stats.trainer_count}</p>
              <p data-cms-field="trainer_label" class="text-fs-muted text-xs mt-1 uppercase tracking-[0.1em] font-semibold">{stats.trainer_label}</p>
            </div>
          </div>
        </div>

        <!-- Image column -->
        <div class="lg:col-span-6 fade-up delay-200">
          <div class="relative">
            <div class="absolute -inset-4 sm:-inset-6 bg-gradient-to-br from-fs-blue-bg to-transparent rounded-3xl"></div>
            <div class="relative rounded-2xl overflow-hidden shadow-xl aspect-[5/6] bg-fs-surface">
              {hero.image
                ? <img src={assetUrl(hero.image, 'width=1200&quality=82&fit=cover')}
                       alt={hero.image_alt}
                       data-cms-collection="hero" data-cms-field="image"
                       class="w-full h-full object-cover" />
                : <div class="w-full h-full bg-gradient-to-br from-fs-blue/20 to-fs-blue-bg"></div>}
            </div>
            <!-- floating chip -->
            <div class="hidden sm:flex absolute -bottom-4 -left-4 bg-white shadow-card-hover border border-fs-border rounded-xl p-4 items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-fs-blue-bg flex items-center justify-center">
                <svg class="w-5 h-5 text-fs-blue" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              </div>
              <div class="leading-tight">
                <p data-cms-collection="site_stats" data-cms-field="rating" class="font-display font-extrabold text-fs-dark text-lg">{stats.rating}</p>
                <p data-cms-collection="site_stats" data-cms-field="rating_label" class="text-fs-muted text-[11px] uppercase tracking-[0.12em] font-semibold">{stats.rating_label}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Featured classes ────────────────────────────────────── -->
  <section id="kurse" class="section bg-fs-surface">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div class="mb-12 sm:mb-14 fade-up">
        <SectionHeader
          eyebrow={home.classes_eyebrow}
          title={home.classes_title}
          lead={home.classes_lead}
          cmsCollection="home_copy"
          cmsEyebrowField="classes_eyebrow"
          cmsTitleField="classes_title"
          cmsLeadField="classes_lead" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
        {classes.slice(0, 3).map((c, i) => (
          <div class={`fade-up delay-${(i + 1) * 100}`}>
            <ClassCard item={c} ui={ui} />
          </div>
        ))}
      </div>
      <div class="text-center mt-12 fade-up delay-300">
        <a href="/kurse" data-cms-collection="home_copy" data-cms-field="classes_all_link_label" class="inline-link">
          {home.classes_all_link_label}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── About teaser ────────────────────────────────────────── -->
  <section class="section bg-fs-white">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Image -->
      <div class="lg:col-span-5 fade-up">
        <div class="relative">
          <div class="absolute -inset-3 bg-gradient-to-br from-fs-blue-bg via-transparent to-transparent rounded-3xl"></div>
          <div class="relative aspect-[4/5] overflow-hidden rounded-2xl shadow-card-hover bg-fs-surface">
            {about.image
              ? <img src={assetUrl(about.image, 'width=900&quality=82&fit=cover')}
                     alt={about.image_alt}
                     data-cms-collection="about" data-cms-field="image"
                     class="w-full h-full object-cover" />
              : <div class="w-full h-full bg-gradient-to-br from-fs-blue/15 to-fs-blue-bg"></div>}
          </div>
        </div>
      </div>

      <!-- Text + stats -->
      <div class="lg:col-span-7 fade-up delay-100" data-cms-collection="about">
        <span data-cms-field="eyebrow" class="eyebrow-plain">{about.eyebrow}</span>
        <h2 data-cms-field="title" class="mt-3 font-display font-extrabold text-fs-dark text-3xl sm:text-4xl lg:text-[2.75rem] leading-[1.1] tracking-tight-2">
          {about.title}
        </h2>
        {about.lead && (
          <p data-cms-field="lead" class="mt-5 text-fs-muted text-lg leading-relaxed max-w-xl">
            {about.lead}
          </p>
        )}
        {about.body && (
          <p data-cms-field="body" class="mt-4 text-fs-muted text-base leading-relaxed max-w-xl">
            {about.body}
          </p>
        )}
        {about.team_link_label && (
          <a href={about.team_link_href || '#'} data-cms-field="team_link_label" class="inline-link mt-6">
            {about.team_link_label}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        )}

        <!-- 2×2 stat grid -->
        <dl data-cms-collection="site_stats" class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 max-w-xl">
          <div class="border border-fs-border rounded-xl p-5 text-center bg-white hover:border-fs-blue/30 transition-colors duration-200">
            <dt data-cms-field="founded_year" class="font-display font-extrabold text-fs-dark text-2xl sm:text-3xl tracking-tight-2">{stats.founded_year}</dt>
            <dd data-cms-field="founded_label" class="text-fs-muted text-xs mt-1.5 uppercase tracking-[0.1em] font-semibold">{stats.founded_label}</dd>
          </div>
          <div class="border border-fs-border rounded-xl p-5 text-center bg-white hover:border-fs-blue/30 transition-colors duration-200">
            <dt data-cms-field="studio_area" class="font-display font-extrabold text-fs-dark text-2xl sm:text-3xl tracking-tight-2">{stats.studio_area}</dt>
            <dd data-cms-field="studio_area_label" class="text-fs-muted text-xs mt-1.5 uppercase tracking-[0.1em] font-semibold">{stats.studio_area_label}</dd>
          </div>
          <div class="border border-fs-border rounded-xl p-5 text-center bg-white hover:border-fs-blue/30 transition-colors duration-200">
            <dt data-cms-field="rating" class="font-display font-extrabold text-fs-dark text-2xl sm:text-3xl tracking-tight-2">{stats.rating}</dt>
            <dd data-cms-field="rating_label" class="text-fs-muted text-xs mt-1.5 uppercase tracking-[0.1em] font-semibold">{stats.rating_label}</dd>
          </div>
          <div class="border border-fs-border rounded-xl p-5 text-center bg-white hover:border-fs-blue/30 transition-colors duration-200">
            <dt data-cms-field="trainer_about_count" class="font-display font-extrabold text-fs-dark text-2xl sm:text-3xl tracking-tight-2">{stats.trainer_about_count}</dt>
            <dd data-cms-field="trainer_about_label" class="text-fs-muted text-xs mt-1.5 uppercase tracking-[0.1em] font-semibold">{stats.trainer_about_label}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ── Membership plans preview ───────────────────────────── -->
  <section class="section bg-fs-surface">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div class="mb-12 sm:mb-14 fade-up">
        <SectionHeader
          eyebrow={home.pricing_eyebrow}
          title={home.pricing_title}
          lead={home.pricing_lead}
          cmsCollection="home_copy"
          cmsEyebrowField="pricing_eyebrow"
          cmsTitleField="pricing_title"
          cmsLeadField="pricing_lead" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto pt-4">
        {plans.slice(0, 3).map((p, i) => (
          <div class={`fade-up delay-${(i + 1) * 100}`}>
            <PricingCard plan={p} ui={ui} />
          </div>
        ))}
      </div>
      <p class="text-center mt-10 text-fs-muted text-sm fade-up delay-300"
         data-cms-collection="home_copy" data-cms-field="pricing_footnote">
        {home.pricing_footnote}
      </p>
      <div class="text-center mt-2 fade-up delay-300">
        <a href="/mitgliedschaft" data-cms-collection="home_copy" data-cms-field="pricing_all_link_label" class="inline-link">
          {home.pricing_all_link_label}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Testimonials ────────────────────────────────────────── -->
  <section class="section bg-fs-white">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div class="mb-12 sm:mb-14 fade-up">
        <SectionHeader
          eyebrow={home.testimonials_eyebrow}
          title={home.testimonials_title}
          cmsCollection="home_copy"
          cmsEyebrowField="testimonials_eyebrow"
          cmsTitleField="testimonials_title" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
        {testimonials.slice(0, 3).map((t, i) => (
          <blockquote
            data-cms-collection="testimonials"
            data-cms-id={String(t.id)}
            class={`bg-fs-surface border border-fs-border rounded-xl p-7 flex flex-col fade-up delay-${(i + 1) * 100}`}>
            <p data-cms-field="rating" class="text-fs-blue text-lg tracking-[0.2em] mb-5">{stars(t.rating)}</p>
            <p data-cms-field="quote" class="text-fs-dark/85 leading-relaxed italic flex-1 text-[15px]">
              "{t.quote}"
            </p>
            <footer class="mt-6 pt-5 border-t border-fs-border">
              <p data-cms-field="author" class="font-semibold text-fs-dark text-sm">{t.author}</p>
              <p data-cms-field="membership_type" class="text-fs-muted text-xs mt-0.5 uppercase tracking-[0.1em] font-semibold">{t.membership_type}</p>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Opening hours strip ─────────────────────────────────── -->
  <section class="section bg-fs-blue text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.08]"
         style="background-image:radial-gradient(circle,#ffffff 1px,transparent 1px);background-size:24px 24px"></div>
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 relative z-10">
      <div class="flex flex-col items-center text-center mb-12 fade-up">
        <span class="inline-block bg-white/15 text-white text-[11px] font-semibold tracking-[0.12em] uppercase px-3 py-1 rounded-full mb-4"
              data-cms-collection="home_copy" data-cms-field="hours_eyebrow">
          {home.hours_eyebrow}
        </span>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl tracking-tight-2"
            data-cms-collection="home_copy" data-cms-field="hours_title">
          {home.hours_title}
        </h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3 sm:gap-4 fade-up delay-100">
        {hours.map(h => (
          <div data-cms-collection="opening_hours" data-cms-id={String(h.id)}
               class:list={[
                 'rounded-xl p-5 text-center transition-all duration-300',
                 h.closed
                   ? 'opacity-60 bg-white/5'
                   : 'bg-white/10 border border-white/20 hover:bg-white/15 hover:-translate-y-0.5',
               ]}>
            <p data-cms-field="weekday" class="text-white/80 text-[10px] sm:text-[11px] font-semibold uppercase tracking-[0.18em] mb-3">{h.weekday.slice(0, 3)}</p>
            {h.closed
              ? <p data-cms-collection="ui_copy" data-cms-field="closed_label" class="text-white/70 text-sm italic font-medium">{ui.closed_label}</p>
              : (
                <p class="text-white text-sm sm:text-[15px] font-semibold tabular-nums">
                  <span data-cms-field="open_from">{h.open_from}</span>
                  <span class="opacity-50">–</span>
                  <span data-cms-field="open_to">{h.open_to}</span>
                </p>
              )}
            {!h.closed && h.note && (
              <p data-cms-field="note" class="text-white/70 text-[11px] mt-1.5 leading-snug">{h.note}</p>
            )}
          </div>
        ))}
      </div>
      <p class="text-center mt-10 fade-up delay-200">
        <a href={`tel:${settings.contact_phone.replace(/\s/g, '')}`}
           data-cms-collection="home_copy" data-cms-field="hours_cta_label"
           class="inline-link on-blue">
          {home.hours_cta_label}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </p>
    </div>
  </section>

</Layout>
